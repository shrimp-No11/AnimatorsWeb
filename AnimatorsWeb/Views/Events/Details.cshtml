@model AnimatorsWeb.Models.EventDetailsViewModel
@using AnimatorsWeb.Models

@{
    var title = $"{Model.TypeLabel} #{Model.Number} — {Model.Theme}";
    ViewData["Title"] = title;
    ViewData["Description"] = $"{Model.TypeLabel} #{Model.Number}: {Model.Theme}. Работы участников и победители.";

    var typeClass = Model.EventType == EventType.ArtJam ? "artjam" : "anijam";
    var hasWinners = Model.WinnerGroups.Any();
}

<style>
    .event-page {
        --ev-line: color-mix(in srgb, var(--brand-text) 12%, transparent);
        --ev-muted: color-mix(in srgb, var(--brand-text) 62%, transparent);
        --ev-accent: var(--brand-primary);
        --ev-soft: color-mix(in srgb, var(--ev-accent) 8%, var(--brand-card));
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 28px 24px 64px;
        color: var(--brand-text);
    }

        .event-page.artjam {
            --ev-accent: var(--brand-accent);
        }

    /* Верхний блок */

    .event-overview {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(300px, .85fr);
        gap: 16px;
        align-items: stretch;
        margin-bottom: 36px;
    }

    /* Информация о мероприятии */

    .event-hero {
        display: flex;
        flex-direction: column;
        gap: 20px;
        min-width: 0;
        padding: 25px 27px;
        border: 1px solid var(--ev-line);
        border-radius: 16px;
        background: radial-gradient( ellipse at 100% 0%, color-mix(in srgb, var(--ev-accent) 13%, transparent), transparent 50% ), var(--brand-card);
    }

    .event-heading {
        min-width: 0;
    }

    .event-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 9px;
        color: var(--ev-accent);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .12em;
        text-transform: uppercase;
    }

        .event-eyebrow::before {
            content: "";
            width: 18px;
            height: 2px;
            border-radius: 2px;
            background: var(--ev-accent);
        }

    .event-title {
        margin: 0;
        font-size: clamp(28px, 4vw, 38px);
        font-weight: 850;
        line-height: 1.1;
        letter-spacing: -.045em;
    }

    .event-theme {
        margin: 9px 0 0;
        color: var(--ev-muted);
        font-size: 16px;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    /* Метаданные */

    .event-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding-top: 15px;
        border-top: 1px solid var(--ev-line);
    }

    .event-meta-item {
        display: flex;
        align-items: center;
        gap: 7px;
        min-height: 35px;
        padding: 6px 10px;
        border: 1px solid var(--ev-line);
        border-radius: 8px;
        background: color-mix(in srgb, var(--brand-card) 75%, var(--brand-bg));
        font-size: 12px;
    }

    .event-meta-icon {
        color: var(--ev-accent);
        font-size: 15px;
    }

    .event-meta-item strong {
        font-size: 13px;
        font-weight: 800;
    }

    .event-meta-item > span:not(.event-meta-icon) {
        color: var(--ev-muted);
    }

    /* Кнопки */

    .event-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: auto;
    }

    .event-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 37px;
        padding: 8px 13px;
        border: 1px solid var(--ev-line);
        border-radius: 8px;
        background: var(--brand-card);
        color: var(--brand-text);
        font-size: 12px;
        font-weight: 650;
        text-decoration: none;
        transition: border-color .2s, transform .2s, background .2s;
    }

        .event-btn:hover {
            transform: translateY(-1px);
            border-color: var(--ev-accent);
            color: var(--brand-text);
        }

        .event-btn.primary {
            border-color: var(--ev-accent);
            background: var(--ev-accent);
            color: var(--brand-card);
        }

            .event-btn.primary:hover {
                filter: brightness(.95);
                color: var(--brand-card);
            }

    /* Победители */

    .event-winners-panel {
        display: flex;
        flex-direction: column;
        min-width: 0;
        padding: 21px;
        border: 1px solid var(--ev-line);
        border-radius: 16px;
        background: var(--brand-card);
    }

    .event-winners-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 15px;
    }

        .event-winners-heading h2 {
            margin: 0;
            font-size: 17px;
            font-weight: 800;
        }

    .event-winners-count {
        color: var(--ev-muted);
        font-size: 12px;
        white-space: nowrap;
    }

    .event-winners {
        display: flex;
        flex-direction: column;
        gap: 9px;
    }

    .event-winner-block {
        min-width: 0;
        padding: 11px 13px;
        border: 1px solid var(--ev-line);
        border-left: 3px solid var(--ev-accent);
        border-radius: 9px;
        background: var(--ev-soft);
    }

    .event-winner-title {
        margin: 0 0 7px;
        color: var(--ev-accent);
        font-size: 12px;
        font-weight: 800;
    }

    .event-winner-list {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }

    .event-winner-person {
        display: inline-flex;
        align-items: center;
        padding: 4px 8px;
        border: 1px solid var(--ev-line);
        border-radius: 6px;
        background: var(--brand-card);
        font-size: 12px;
        font-weight: 650;
    }

        .event-winner-person a {
            color: var(--brand-text);
            text-decoration: none;
        }

            .event-winner-person a:hover {
                color: var(--ev-accent);
                text-decoration: underline;
            }

    /* Секция работ */

    .event-section {
        margin-bottom: 36px;
    }

    .event-section-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 17px;
    }

    .event-section-title {
        margin: 0;
        font-size: 21px;
        font-weight: 850;
        letter-spacing: -.025em;
    }

    .event-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
        gap: 14px;
    }

    .event-work {
        position: relative;
        min-width: 0;
        overflow: hidden;
        border: 1px solid var(--ev-line);
        border-radius: 12px;
        background: var(--brand-card);
        transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
    }

        .event-work:hover {
            transform: translateY(-3px);
            border-color: color-mix(in srgb, var(--ev-accent) 45%, transparent);
            box-shadow: 0 10px 24px color-mix(in srgb, var(--brand-text) 9%, transparent);
        }

    .event-work-thumb {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        aspect-ratio: 4 / 3;
        overflow: hidden;
        background: var(--brand-bg);
    }

        .event-work-thumb img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .35s ease;
        }

    .event-work:hover .event-work-thumb img {
        transform: scale(1.04);
    }

    .event-work-thumb .icon {
        color: var(--ev-muted);
        font-size: 32px;
    }

    .event-work-info {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 3px;
        min-height: 48px;
        padding: 11px 13px;
        font-size: 13px;
        line-height: 1.5;
    }

        .event-work-info a {
            color: var(--brand-text);
            font-weight: 650;
            text-decoration: none;
        }

            .event-work-info a:hover {
                color: var(--ev-accent);
                text-decoration: underline;
            }

    /* Бейджи */

    .work-badge {
        position: absolute;
        top: 9px;
        right: 9px;
        z-index: 4;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 30px;
        min-height: 30px;
        padding: 4px;
        border: 1px solid color-mix(in srgb, var(--brand-text) 10%, transparent);
        border-radius: 8px;
        background: var(--brand-card);
        font-size: 17px;
        line-height: 1;
        box-shadow: 0 2px 8px color-mix(in srgb, var(--brand-text) 12%, transparent);
        pointer-events: none;
    }

    .work-attachments-badge {
        position: absolute;
        right: 9px;
        bottom: 9px;
        z-index: 3;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 27px;
        height: 27px;
        border: 1px solid color-mix(in srgb, var(--brand-card) 40%, transparent);
        border-radius: 7px;
        background: color-mix(in srgb, var(--brand-text) 75%, transparent);
        color: var(--brand-card);
        pointer-events: none;
    }

        .work-attachments-badge svg {
            width: 14px;
            height: 14px;
            fill: none;
            stroke: currentColor;
            stroke-width: 2.2;
        }

    /* Пустое состояние */

    .event-empty {
        padding: 36px 20px;
        border: 1px dashed var(--ev-line);
        border-radius: 12px;
        background: var(--brand-card);
        color: var(--ev-muted);
        font-size: 14px;
        text-align: center;
    }

    /* Адаптивность */

    @@media (max-width: 800px) {
        .event-page {
            padding-inline: 18px;
        }

        .event-overview {
            grid-template-columns: 1fr;
            gap: 12px;
            margin-bottom: 30px;
        }

        .event-hero {
            padding: 22px;
        }

        .event-winners-panel {
            padding: 18px;
        }

        .event-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 11px;
        }
    }

    @@media (max-width: 600px) {
        .event-page {
            padding: 18px 14px 44px;
        }

        .event-hero {
            gap: 17px;
            padding: 19px;
            border-radius: 14px;
        }

        .event-title {
            font-size: 27px;
        }

        .event-theme {
            font-size: 15px;
        }

        .event-meta {
            gap: 7px;
        }

        .event-meta-item {
            gap: 6px;
            padding: 7px 9px;
            font-size: 12px;
        }

        .event-actions {
            gap: 7px;
        }

        .event-btn {
            min-height: 36px;
            padding: 8px 11px;
            font-size: 12px;
        }

        .event-winners-panel {
            padding: 15px;
        }

        .event-section {
            margin-bottom: 30px;
        }

        .event-section-title {
            font-size: 19px;
        }

        .event-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        .event-work-info {
            min-height: 42px;
            padding: 9px 10px;
            font-size: 12px;
        }

        .work-badge {
            top: 6px;
            right: 6px;
            min-width: 27px;
            min-height: 27px;
            font-size: 15px;
        }
    }

    @@media (max-width: 360px) {
        .event-page {
            padding-inline: 10px;
        }

        .event-hero {
            padding: 16px;
        }

        .event-title {
            font-size: 24px;
        }

        .event-meta-item {
            padding-inline: 7px;
        }

        .event-grid {
            gap: 8px;
        }
    }
</style>

<main class="event-page @typeClass">

    <div class="event-overview">

        <!-- Информация о мероприятии -->
        <header class="event-hero">

            <div class="event-heading">

                <h1 class="event-title">@Model.TypeLabel #@Model.Number</h1>

                <p class="event-theme">@Model.Theme</p>
            </div>

            <div class="event-meta">

                <div class="event-meta-item">
                    <span class="event-meta-icon">♙</span>
                    <strong>@Model.ParticipantsCount</strong>
                    <span>участников</span>
                </div>

                <div class="event-meta-item">
                    <span class="event-meta-icon">◷</span>
                    <span>Сроки</span>
                    <strong>
                        <span class="local-date"
                              data-utc="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm:ssZ")"
                              data-format="dd.MM.yyyy">@Model.StartDate.ToString("dd.MM.yyyy")</span>
                               - 
                        <span class="local-date"
                              data-utc="@Model.EndDate.ToString("yyyy-MM-ddTHH:mm:ssZ")"
                              data-format="dd.MM.yyyy">@Model.EndDate.ToString("dd.MM.yyyy")</span>
                    </strong>
                </div>
                

            </div>

            <div class="event-actions">

                <a asp-controller="Events"
                   asp-action="Index"
                   asp-route-tab="@(Model.EventType == EventType.ArtJam ? "artjam" : "anijam")"
                   class="event-btn">
                    ← Все ивенты
                </a>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    @if (!string.IsNullOrEmpty(Model.AnnouncementUrl))
                    {
                        <a href="@Model.AnnouncementUrl" target="_blank" rel="noopener" class="event-btn">#Anijam</a>
                    }
                    @if (!string.IsNullOrEmpty(Model.ResultsUrl))
                    {
                        <a href="@Model.ResultsUrl" target="_blank" rel="noopener" class="event-btn">#Зал_Славы</a>
                    }
                }

                @if (User.HasClaim("is_moderator", "true"))
                {
                    <a asp-controller="Moderator"
                       asp-action="EditAnimJam"
                       asp-route-number="@Model.Number"
                       asp-route-eventType="@Model.TypeLabel"
                       class="event-btn primary">
                        🛠 Редактировать
                    </a>
                }

            </div>

        </header>

        <!-- Победители -->
        @if (hasWinners)
        {
            <aside class="event-winners-panel">

                <div class="event-winners">

                    @foreach (var group in Model.WinnerGroups)
                    {
                        <div class="event-winner-block">

                            <div class="event-winner-title">
                                @Html.Raw(group.NominationDisplayHtml)
                            </div>

                            <div class="event-winner-list">

                                @foreach (var p in group.Winners)
                                {
                                    <span class="event-winner-person">
                                        <a asp-controller="User"
                                           asp-action="PublicProfile"
                                           asp-route-id="@p.DiscordUserId">
                                            @p.DisplayName
                                        </a>
                                    </span>
                                }

                            </div>

                        </div>
                    }

                </div>

            </aside>
        }

    </div>

    <!-- Работы участников -->
    <section class="event-section">

        <div class="event-section-header">
            <h2 class="event-section-title">
                Работы участников (@Model.Works.Count)
            </h2>
        </div>

        @if (!Model.Works.Any())
        {
            <div class="event-empty">
                Пока нет работ.
            </div>
        }
        else
        {
            <div class="event-grid">

                @foreach (var work in Model.Works)
                {
                    <div class="event-work">

                        @if (!string.IsNullOrEmpty(work.BadgeHtml))
                        {
                            <div class="work-badge">
                                @Html.Raw(work.BadgeHtml)
                            </div>
                        }

                        @if (work.AttachmentsCount > 1)
                        {
                            <span class="work-attachments-badge"
                                  aria-label="Несколько вложений">
                                <svg viewBox="0 0 24 24">
                                    <rect x="9" y="9" width="11" height="11" rx="2" />
                                    <path d="M15 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h3" />
                                </svg>
                            </span>
                        }

                        <div class="event-work-thumb js-open-work"
                             data-work-url="@work.WorkUrl"
                             data-message-url="@work.MessageUrl"
                             data-participant-id="@work.Id"
                             data-media-type="@work.MediaType"
                             style="cursor: pointer;">

                            @if (work.MediaType == "link")
                            {
                                <span class="icon">🔗</span>
                            }
                            else
                            {
                                <img src="@work.ThumbnailUrl"
                                     loading="lazy"
                                     decoding="async"
                                     alt=""
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                <span class="icon" style="display:none;">🎨</span>
                            }

                        </div>

                        <div class="event-work-info">

                            @for (int i = 0; i < work.People.Count; i++)
                            {
                                var p = work.People[i];

                                <a asp-controller="User"
                                   asp-action="PublicProfile"
                                   asp-route-id="@p.DiscordUserId">
                                    @p.DisplayName
                                </a>

                                if (i < work.People.Count - 2)
                                {
                                    <span>, </span>
                                }
                                else if (i == work.People.Count - 2)
                                {
                                    <span> и </span>
                                }
                            }

                        </div>

                    </div>
                }

            </div>
        }

    </section>

</main>

@section Scripts {
    <script>
        document.querySelectorAll('.local-date').forEach(el => {
            const d = new Date(el.dataset.utc);
            if (isNaN(d)) return;

            const pad = n => String(n).padStart(2, '0');
            el.textContent = `${pad(d.getDate())}.${pad(d.getMonth() + 1)}.${d.getFullYear()}`;
        });
    </script>
}