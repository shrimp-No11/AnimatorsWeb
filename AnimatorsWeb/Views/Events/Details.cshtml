@model AnimatorsWeb.Models.ArtJamDetailsViewModel
@using AnimatorsWeb.Models
@using AnimatorsWeb.Helpers

@{
    ViewData["Title"] = $"ArtJam #{Model.Number} — {Model.Theme}";
    ViewData["Description"] = $"АртДжем #{Model.Number}: {Model.Theme}. Работы участников и победители.";
}

<style>
    .aj-page {
        --aj-line: color-mix(in srgb, var(--brand-text) 12%, transparent);
        --aj-muted: color-mix(in srgb, var(--brand-text) 62%, transparent);
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px 0 60px;
        color: var(--brand-text);
    }

    .aj-hero {
        position: relative;
        padding: 32px;
        margin-bottom: 28px;
        border: 1px solid var(--aj-line);
        border-radius: 24px;
        background: radial-gradient(ellipse at 90% 0%, color-mix(in srgb, var(--brand-accent) 18%, transparent), transparent 45%), radial-gradient(ellipse at 0% 100%, color-mix(in srgb, var(--brand-accent) 14%, transparent), transparent 50%), color-mix(in srgb, var(--brand-card) 86%, var(--brand-accent) 4%);
        box-shadow: 0 18px 50px color-mix(in srgb, var(--brand-accent) 6%, transparent);
    }

    .aj-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 12px;
        color: var(--brand-accent);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .13em;
        text-transform: uppercase;
    }

        .aj-eyebrow::before {
            content: "";
            width: 22px;
            height: 2px;
            border-radius: 2px;
            background: linear-gradient(90deg, var(--brand-accent), var(--brand-accent));
        }

    .aj-title {
        margin: 0 0 8px;
        font-size: clamp(28px, 4vw, 44px);
        font-weight: 800;
        letter-spacing: -.04em;
        line-height: 1.1;
    }

    .aj-theme {
        margin: 0 0 16px;
        color: var(--aj-muted);
        font-size: 18px;
    }

    .aj-meta {
        display: flex;
        gap: 24px;
        flex-wrap: wrap;
        font-size: 14px;
        color: var(--aj-muted);
    }

    .aj-meta-item strong {
        color: var(--brand-text);
        font-size: 18px;
        font-weight: 700;
        display: block;
        margin-bottom: 2px;
    }

    .aj-actions {
        display: flex;
        gap: 10px;
        margin-top: 20px;
        flex-wrap: wrap;
    }

    .aj-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 10px;
        border: 1px solid var(--aj-line);
        background: var(--brand-card);
        color: var(--brand-text);
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: transform .15s, border-color .15s;
    }

        .aj-btn:hover {
            transform: translateY(-1px);
            border-color: var(--brand-primary);
            color: var(--brand-text);
        }

        .aj-btn.primary {
            background: var(--brand-primary);
            color: #fff;
            border-color: var(--brand-primary);
        }

    .aj-section {
        margin-bottom: 32px;
    }

    .aj-section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 16px;
        font-size: 22px;
        font-weight: 800;
    }

    .aj-winner-block {
        padding: 24px;
        border-radius: 16px;
        border: 1px solid color-mix(in srgb, var(--brand-accent) 25%, transparent);
        background: linear-gradient(135deg, color-mix(in srgb, var(--brand-accent) 8%, var(--brand-card)), var(--brand-card) 70%);
    }

    .aj-winner-title {
        font-size: 18px;
        font-weight: 800;
        margin: 0 0 12px;
        color: var(--brand-accent);
    }

    .aj-winner-list {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .aj-winner-person {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border-radius: 999px;
        background: var(--brand-card);
        border: 1px solid var(--aj-line);
        font-size: 15px;
        font-weight: 600;
    }

        .aj-winner-person a {
            color: var(--brand-text);
            text-decoration: none;
        }

            .aj-winner-person a:hover {
                color: var(--brand-primary);
                text-decoration: underline;
            }

    .aj-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 16px;
    }

    .aj-work {
        position: relative;
        border: 1px solid var(--aj-line);
        border-radius: 14px;
        overflow: hidden;
        background: var(--brand-card);
        cursor: pointer;
        transition: transform .2s, box-shadow .2s, border-color .2s;
    }

        .aj-work:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 28px rgba(0,0,0,0.1);
            border-color: color-mix(in srgb, var(--brand-accent) 40%, transparent);
        }

    .aj-work-thumb {
        aspect-ratio: 4/3;
        background: #111;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .aj-work-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .aj-work-thumb .icon {
            color: #666;
            font-size: 36px;
        }

    .aj-work-info {
        padding: 10px 12px;
        font-size: 13px;
        line-height: 1.4;
    }

        .aj-work-info a {
            color: var(--brand-text);
            text-decoration: none;
            font-weight: 600;
        }

            .aj-work-info a:hover {
                color: var(--brand-primary);
                text-decoration: underline;
            }

    .aj-empty {
        padding: 32px;
        border: 1px dashed var(--aj-line);
        border-radius: 14px;
        text-align: center;
        color: var(--aj-muted);
    }

    @@media (max-width: 700px) {
        .aj-hero {
            padding: 22px;
            border-radius: 18px;
        }

        .aj-title {
            font-size: 26px;
        }

        .aj-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }
    }
</style>

<main class="aj-page">

    <header class="aj-hero">
        <div class="aj-eyebrow">ArtJam</div>
        <h1 class="aj-title">ArtJam #@Model.Number</h1>
        <p class="aj-theme">@Model.Theme</p>

        <div class="aj-meta">
            <div class="aj-meta-item">
                <strong>@Model.ParticipantsCount</strong>
                <span>участников</span>
            </div>
            <div class="aj-meta-item">
                <strong>
                    <span class="local-date" data-utc="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm:ssZ")" data-format="dd.MM.yyyy">@Model.StartDate.ToString("dd.MM.yyyy")</span>
                </strong>
                <span>начало</span>
            </div>
            <div class="aj-meta-item">
                <strong>
                    <span class="local-date" data-utc="@Model.EndDate.ToString("yyyy-MM-ddTHH:mm:ssZ")" data-format="dd.MM.yyyy">@Model.EndDate.ToString("dd.MM.yyyy")</span>
                </strong>
                <span>окончание</span>
            </div>
        </div>

        <div class="aj-actions">
            <a asp-controller="Events" asp-action="Index" asp-route-tab="artjam" class="aj-btn">← К списку</a>

            @if (!string.IsNullOrEmpty(Model.AnnouncementUrl))
            {
                <a href="@Model.AnnouncementUrl" target="_blank" rel="noopener" class="aj-btn">📢 Объявление</a>
            }
            @if (!string.IsNullOrEmpty(Model.ResultsUrl))
            {
                <a href="@Model.ResultsUrl" target="_blank" rel="noopener" class="aj-btn">🏆 Итоги в Discord</a>
            }
            @if (User.HasClaim("is_moderator", "true"))
            {
                <a asp-controller="Moderator" asp-action="EditAnimJam"
                   asp-route-number="@Model.Number" asp-route-eventType="ArtJam"
                   class="aj-btn primary">🛠 Редактировать</a>
            }
        </div>
    </header>

    @if (Model.WinnerGroups.Any())
    {
        <section class="aj-section">
            @foreach (var group in Model.WinnerGroups)
            {
                <div class="aj-winner-block">
                    <div class="aj-winner-title">@group.Title</div>
                    <div class="aj-winner-list">
                        @foreach (var p in group.People)
                        {
                            <span class="aj-winner-person">
                                <a asp-controller="User" asp-action="PublicProfile" asp-route-id="@p.DiscordUserId">
                                    @p.DisplayName
                                </a>
                            </span>
                        }
                    </div>
                </div>
            }
        </section>
    }

    <section class="aj-section">
        <h2 class="aj-section-title">Работы (@Model.Works.Count)</h2>

        @if (!Model.Works.Any())
        {
            <div class="aj-empty">Пока нет работ.</div>
        }
        else
        {
            <div class="aj-grid">
                @foreach (var work in Model.Works)
                {
                    <div class="aj-work js-open-work"
                         data-work-url="@work.WorkUrl"
                         data-message-url="@work.MessageUrl"
                         data-participant-id="@work.PrimaryParticipantId"
                         data-media-type="@work.MediaType">
                        <div class="aj-work-thumb">
                            @if (work.MediaType == "link")
                            {
                                <span class="icon">🔗</span>
                            }
                            else
                            {
                                <img src="/Featured/Thumbnail/@work.PrimaryParticipantId"
                                     loading="lazy" decoding="async" alt=""
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                <span class="icon" style="display:none;">🎨</span>
                            }
                        </div>
                        <div class="aj-work-info">
                            @for (int i = 0; i < work.People.Count; i++)
                            {
                                var p = work.People[i];
                                <a asp-controller="User" asp-action="PublicProfile" asp-route-id="@p.DiscordUserId">@p.DisplayName</a>
                                if (i < work.People.Count - 2)
                                {
                                    <span>, </span>
                                }
                                else if (i == work.People.Count - 2)
                                {
                                    <span> и </span>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </section>

</main>

@section Scripts {
    <script>
        document.querySelectorAll('.local-date').forEach(el => {
            const d = new Date(el.dataset.utc);
            if (isNaN(d)) return;
            const pad = n => String(n).padStart(2, '0');
            el.textContent = `${pad(d.getDate())}.${pad(d.getMonth() + 1)}.${d.getFullYear()}`;
        });
    </script>
}