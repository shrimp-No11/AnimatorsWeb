@model AnimatorsWeb.Models.UserWorksViewModel

@{
    ViewData["Title"] = $"Работы {Model.DisplayName}";
}

<style>
    .works-page {
        color: var(--brand-text);
        width: 100%;
    }

    .works-header {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 8px;
    }

    .works-title {
        margin: 0;
        font-size: clamp(1.8rem, 4vw, 2.5rem);
        font-weight: 750;
        letter-spacing: -.035em;
        overflow-wrap: anywhere;
    }

    .works-count {
        color: var(--brand-primary);
        font-size: .95rem;
        font-weight: 700;
    }

    .works-description {
        margin: 10px 0 24px;
        color: var(--brand-text);
        opacity: .7;
        font-size: .92rem;
    }

    .works-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
        gap: 20px;
    }

    .work-card {
        min-width: 0;
        overflow: hidden;
        background: var(--brand-card);
        border: 1px solid color-mix(in srgb, var(--brand-text) 11%, transparent);
        border-radius: 16px;
        box-shadow: 0 5px 20px color-mix(in srgb, var(--brand-text) 4%, transparent);
        transition: transform .2s, box-shadow .2s, border-color .2s;
    }

    .work-card:hover {
        transform: translateY(-4px);
        border-color: color-mix(in srgb, var(--brand-primary) 40%, transparent);
        box-shadow: 0 12px 28px color-mix(in srgb, var(--brand-text) 9%, transparent);
    }

    .work-preview {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        padding: 0;
        color: white;
        background: #171717;
        border: 0;
        cursor: pointer;
    }

    .work-preview::after {
        position: absolute;
        inset: 0;
        content: "";
        background: linear-gradient(
            to top,
            rgba(0, 0, 0, .35),
            transparent 45%
        );
        opacity: .7;
        pointer-events: none;
        transition: opacity .2s;
    }

    .work-preview:hover::after {
        opacity: 1;
    }

    .work-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .35s;
    }

    .work-card:hover .work-preview img {
        transform: scale(1.04);
    }

    .work-preview-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        color: white;
        font-size: 2.5rem;
        background:
            radial-gradient(
                circle at 50% 40%,
                color-mix(in srgb, var(--brand-primary) 38%, #242424),
                #171717 75%
            );
    }

    .work-link-icon {
        font-size: 2rem;
    }

    .work-play-indicator {
        position: absolute;
        z-index: 2;
        right: 12px;
        bottom: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        color: white;
        background: rgba(0, 0, 0, .65);
        border: 1px solid rgba(255, 255, 255, .25);
        border-radius: 50%;
        font-size: .9rem;
        transition: transform .2s, background .2s;
    }

    .work-preview:hover .work-play-indicator {
        transform: scale(1.08);
        background: var(--brand-primary);
    }

    .work-badge {
        position: absolute;
        z-index: 3;
        top: 10px;
        right: 10px;
        max-width: calc(100% - 20px);
        padding: 5px 9px;
        overflow: hidden;
        color: #242424;
        background: rgba(255, 255, 255, .94);
        border: 1px solid rgba(0, 0, 0, .06);
        border-radius: 8px;
        font-size: .9rem;
        line-height: 1.3;
        text-overflow: ellipsis;
        white-space: nowrap;
        backdrop-filter: blur(8px);
    }

    .work-card-body {
        padding: 15px 16px 17px;
    }

    .work-jam-link {
        color: var(--brand-primary);
        font-weight: 750;
        text-decoration: none;
    }

    .work-jam-link:hover {
        text-decoration: underline;
    }

    .work-theme {
        margin-left: 4px;
        font-size: .9rem;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    .work-nomination {
        margin-top: 10px;
        color: var(--brand-primary);
        font-size: .83rem;
        font-weight: 650;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    .works-empty {
        padding: 42px 24px;
        text-align: center;
        background: var(--brand-card);
        border: 1px dashed color-mix(in srgb, var(--brand-text) 22%, transparent);
        border-radius: 16px;
    }

    .works-empty-icon {
        margin-bottom: 12px;
        font-size: 2.5rem;
    }

    .works-empty-title {
        margin: 0 0 8px;
        font-size: 1.15rem;
        font-weight: 750;
    }

    .works-empty-text {
        margin: 0;
        color: var(--brand-text);
        opacity: .7;
        font-size: .92rem;
    }

    .works-back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 26px;
        color: var(--brand-primary);
        font-weight: 650;
        text-decoration: none;
    }

    .works-back-link:hover {
        text-decoration: underline;
    }

    /* Модальное окно */

    .work-modal {
        position: fixed;
        z-index: 2000;
        inset: 0;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: rgba(0, 0, 0, .88);
        backdrop-filter: blur(5px);
    }

    .work-modal.is-open {
        display: flex;
    }

    .work-modal-content {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        max-width: 1100px;
        max-height: 90vh;
    }

    .work-modal-content iframe {
        display: block;
        width: min(100%, 1100px);
        aspect-ratio: 16 / 9;
        max-height: 85vh;
        background: #000;
        border: 0;
        border-radius: 12px;
    }

    .work-modal-content video,
    .work-modal-content img {
        display: block;
        max-width: 100%;
        max-height: 85vh;
        object-fit: contain;
        border-radius: 10px;
    }

    .work-modal-close {
        position: fixed;
        z-index: 2001;
        top: 16px;
        right: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        color: white;
        background: rgba(255, 255, 255, .12);
        border: 1px solid rgba(255, 255, 255, .2);
        border-radius: 50%;
        font-size: 1.6rem;
        cursor: pointer;
        transition: background .2s;
    }

    .work-modal-close:hover {
        background: rgba(255, 255, 255, .24);
    }

    @@media (max-width: 600px) {
        .works-grid {
            grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr));
            gap: 14px;
        }

        .work-card-body {
            padding: 12px 13px 14px;
        }

        .work-modal {
            padding: 12px;
        }

        .work-modal-content iframe {
            border-radius: 8px;
        }

        .work-modal-close {
            top: 10px;
            right: 10px;
            width: 40px;
            height: 40px;
        }
    }

    @@media (max-width: 420px) {
        .works-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="works-page">
    <div class="works-header">
        <h1 class="works-title">Работы @Model.DisplayName</h1>
        <span class="works-count">@Model.Works.Count</span>
    </div>


    @if (!Model.Works.Any())
    {
        <div class="works-empty">
            <div class="works-empty-icon" aria-hidden="true">🎬</div>
            <h2 class="works-empty-title">Пока нет работ</h2>
            <p class="works-empty-text">
                Здесь появятся работы участника, когда они будут добавлены.
            </p>
        </div>
    }
    else
    {
        <div class="works-grid">
            @foreach (var work in Model.Works)
            {
                <article class="work-card">
                    <button type="button"
                            class="work-preview js-open-work"
                            data-work-url="@work.WorkUrl"
                            data-message-url="@work.MessageUrl"
                            data-work-id="@work.Id"
                            aria-label="Открыть работу для AniJam #@work.AnimJamNumber">

                        @if (!string.IsNullOrEmpty(work.BadgeHtml))
                        {
                            <span class="work-badge">
                                @Html.Raw(work.BadgeHtml)
                            </span>
                        }

                        @if (work.MediaType == "link")
                        {
                            <span class="work-preview-placeholder work-link-icon" aria-hidden="true">
                                🔗
                            </span>
                        }
                        else
                        {
                            <img src="/Featured/Thumbnail/@work.Id"
                                 loading="lazy"
                                 decoding="async"
                                 alt="Превью работы для AniJam #@work.AnimJamNumber"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                            <span class="work-preview-placeholder"
                                  style="display: none;"
                                  aria-hidden="true">
                                🎬
                            </span>
                        }

                        <span class="work-play-indicator" aria-hidden="true">▶</span>
                    </button>

                    <div class="work-card-body">
                        <div>
                            <a asp-controller="AnimJams"
                               asp-action="Details"
                               asp-route-number="@work.AnimJamNumber"
                               class="work-jam-link">
                                AniJam #@work.AnimJamNumber
                            </a>

                            <span class="work-theme">— @work.Theme</span>
                        </div>

                        @if (!string.IsNullOrEmpty(work.NominationDisplayHtml))
                        {
                            <div class="work-nomination">
                                @Html.Raw(work.NominationDisplayHtml)
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    }

    <a asp-action="Profile" class="works-back-link">
        <span aria-hidden="true">←</span>
        Назад в профиль
    </a>
</div>

<div id="work-modal"
     class="work-modal"
     role="dialog"
     aria-modal="true"
     aria-label="Просмотр работы">

    <button type="button"
            id="work-modal-close"
            class="work-modal-close"
            aria-label="Закрыть просмотр">
        &times;
    </button>

    <div id="work-modal-content" class="work-modal-content"></div>
</div>

<script>
    (() => {
        const modal = document.getElementById('work-modal');
        const content = document.getElementById('work-modal-content');
        const closeButton = document.getElementById('work-modal-close');

        function extractYouTubeId(url) {
            if (!url) return null;

            const match = url.match(
                /(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|v\/))([a-zA-Z0-9_-]{11})/
            );

            return match ? match[1] : null;
        }

        function openModal(element) {
            const workUrl = element.dataset.workUrl || '';
            const messageUrl = element.dataset.messageUrl || '';
            const workId = Number.parseInt(element.dataset.workId || '0', 10);

            const youtubeId = extractYouTubeId(workUrl);

            if (youtubeId) {
                const iframe = document.createElement('iframe');

                iframe.src = `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1`;
                iframe.title = 'Видео с YouTube';
                iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
                iframe.allowFullscreen = true;

                content.replaceChildren(iframe);
                showModal();
                return;
            }

            if (workId > 0) {
                const lowerUrl = workUrl.toLowerCase();
                const proxyUrl = `/Media/StreamWork/${workId}`;

                if (/\.(mp4|webm|mov)(?:[?#]|$)/i.test(lowerUrl)) {
                    const video = document.createElement('video');

                    video.src = proxyUrl;
                    video.controls = true;
                    video.autoplay = true;
                    video.playsInline = true;

                    content.replaceChildren(video);
                    showModal();
                    return;
                }

                if (/\.(gif|png|jpe?g|webp)(?:[?#]|$)/i.test(lowerUrl)) {
                    const img = document.createElement('img');

                    img.src = proxyUrl;
                    img.alt = 'Работа участника';

                    content.replaceChildren(img);
                    showModal();
                    return;
                }
            }

            const externalUrl = messageUrl || workUrl;

            if (externalUrl) {
                const opened = window.open(externalUrl, '_blank', 'noopener,noreferrer');

                if (opened) {
                    opened.opener = null;
                }
            }
        }

        function showModal() {
            modal.classList.add('is-open');
            document.body.style.overflow = 'hidden';
            closeButton.focus();
        }

        function closeModal() {
            modal.classList.remove('is-open');
            content.replaceChildren();
            document.body.style.overflow = '';
        }

        document.querySelectorAll('.js-open-work').forEach(button => {
            button.addEventListener('click', () => openModal(button));
        });

        closeButton.addEventListener('click', closeModal);

        modal.addEventListener('click', event => {
            if (event.target === modal) {
                closeModal();
            }
        });

        document.addEventListener('keydown', event => {
            if (event.key === 'Escape' && modal.classList.contains('is-open')) {
                closeModal();
            }
        });
    })();
</script>