@model AnimatorsWeb.Models.UserWorksViewModel

@{
    ViewData["Title"] = $"Работы {Model.DisplayName}";
}

<style>
    .works-page {
        color: var(--brand-text);
        width: 100%;
    }

    .works-header {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 8px;
    }

    .works-title {
        margin: 0;
        font-size: clamp(1.8rem, 4vw, 2.5rem);
        font-weight: 750;
        letter-spacing: -.035em;
        overflow-wrap: anywhere;
    }

    .works-count {
        color: var(--brand-primary);
        font-size: .95rem;
        font-weight: 700;
    }

    .works-description {
        margin: 10px 0 24px;
        color: var(--brand-text);
        opacity: .7;
        font-size: .92rem;
    }

    .works-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
        gap: 20px;
    }

    .work-card {
        min-width: 0;
        overflow: hidden;
        background: var(--brand-card);
        border: 1px solid color-mix(in srgb, var(--brand-text) 11%, transparent);
        border-radius: 16px;
        box-shadow: 0 5px 20px color-mix(in srgb, var(--brand-text) 4%, transparent);
        transition: transform .2s, box-shadow .2s, border-color .2s;
    }

    .work-card:hover {
        transform: translateY(-4px);
        border-color: color-mix(in srgb, var(--brand-primary) 40%, transparent);
        box-shadow: 0 12px 28px color-mix(in srgb, var(--brand-text) 9%, transparent);
    }

    .work-preview {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        padding: 0;
        color: white;
        background: #171717;
        border: 0;
        cursor: pointer;
    }

    .work-preview::after {
        position: absolute;
        inset: 0;
        content: "";
        background: linear-gradient(
            to top,
            rgba(0, 0, 0, .35),
            transparent 45%
        );
        opacity: .7;
        pointer-events: none;
        transition: opacity .2s;
    }

    .work-preview:hover::after {
        opacity: 1;
    }

    .work-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .35s;
    }

    .work-card:hover .work-preview img {
        transform: scale(1.04);
    }

    .work-preview-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        color: white;
        font-size: 2.5rem;
        background:
            radial-gradient(
                circle at 50% 40%,
                color-mix(in srgb, var(--brand-primary) 38%, #242424),
                #171717 75%
            );
    }

    .work-link-icon {
        font-size: 2rem;
    }

    .work-play-indicator {
        position: absolute;
        z-index: 2;
        right: 12px;
        bottom: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        color: white;
        background: rgba(0, 0, 0, .65);
        border: 1px solid rgba(255, 255, 255, .25);
        border-radius: 50%;
        font-size: .9rem;
        transition: transform .2s, background .2s;
    }

    .work-preview:hover .work-play-indicator {
        transform: scale(1.08);
        background: var(--brand-primary);
    }

    .work-badge {
        position: absolute;
        z-index: 3;
        top: 10px;
        right: 10px;
        max-width: calc(100% - 20px);
        padding: 5px 9px;
        overflow: hidden;
        color: #242424;
        background: rgba(255, 255, 255, .94);
        border: 1px solid rgba(0, 0, 0, .06);
        border-radius: 8px;
        font-size: .9rem;
        line-height: 1.3;
        text-overflow: ellipsis;
        white-space: nowrap;
        backdrop-filter: blur(8px);
    }

    .work-card-body {
        padding: 15px 16px 17px;
    }

    .work-jam-link {
        color: var(--brand-primary);
        font-weight: 750;
        text-decoration: none;
    }

    .work-jam-link:hover {
        text-decoration: underline;
    }

    .work-theme {
        margin-left: 4px;
        font-size: .9rem;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    .work-nomination {
        margin-top: 10px;
        color: var(--brand-primary);
        font-size: .83rem;
        font-weight: 650;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    .works-empty {
        padding: 42px 24px;
        text-align: center;
        background: var(--brand-card);
        border: 1px dashed color-mix(in srgb, var(--brand-text) 22%, transparent);
        border-radius: 16px;
    }

    .works-empty-icon {
        margin-bottom: 12px;
        font-size: 2.5rem;
    }

    .works-empty-title {
        margin: 0 0 8px;
        font-size: 1.15rem;
        font-weight: 750;
    }

    .works-empty-text {
        margin: 0;
        color: var(--brand-text);
        opacity: .7;
        font-size: .92rem;
    }

    .works-back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 26px;
        color: var(--brand-primary);
        font-weight: 650;
        text-decoration: none;
    }

    .works-back-link:hover {
        text-decoration: underline;
    }



    @@media (max-width: 600px) {
        .works-grid {
            grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr));
            gap: 14px;
        }

        .work-card-body {
            padding: 12px 13px 14px;
        }

    }

    @@media (max-width: 420px) {
        .works-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="works-page">
    <div class="works-header">
        <h1 class="works-title">Работы @Model.DisplayName</h1>
        <span class="works-count">@Model.Works.Count</span>
    </div>


    @if (!Model.Works.Any())
    {
        <div class="works-empty">
            <div class="works-empty-icon" aria-hidden="true">🎬</div>
            <h2 class="works-empty-title">Пока нет работ</h2>
            <p class="works-empty-text">
                Здесь появятся работы участника, когда они будут добавлены.
            </p>
        </div>
    }
    else
    {
        <div class="works-grid">
            @foreach (var work in Model.Works)
            {
                <article class="work-card">
                    <button type="button"
                        class="work-preview js-open-work"
                        data-work-url="@work.WorkUrl"
                        data-message-url="@work.MessageUrl"
                        data-participant-id="@work.Id"
                        data-media-type="@work.MediaType"
                        aria-label="Открыть работу для AniJam #@work.AnimJamNumber">

                        @if (!string.IsNullOrEmpty(work.BadgeHtml))
                        {
                            <span class="work-badge">
                                @Html.Raw(work.BadgeHtml)
                            </span>
                        }

                        @if (work.MediaType == "link")
                        {
                            <span class="work-preview-placeholder work-link-icon" aria-hidden="true">
                                🔗
                            </span>
                        }
                        else
                        {
                            <img src="/Featured/Thumbnail/@work.Id"
                                 loading="lazy"
                                 decoding="async"
                                 alt="Превью работы для AniJam #@work.AnimJamNumber"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                            <span class="work-preview-placeholder"
                                  style="display: none;"
                                  aria-hidden="true">
                                🎬
                            </span>
                        }

                        <span class="work-play-indicator" aria-hidden="true">▶</span>
                    </button>

                    <div class="work-card-body">
                        <div>
                            <a asp-controller="AnimJams"
                               asp-action="Details"
                               asp-route-number="@work.AnimJamNumber"
                               class="work-jam-link">
                                AniJam #@work.AnimJamNumber
                            </a>

                            <span class="work-theme">— @work.Theme</span>
                        </div>

                        @if (!string.IsNullOrEmpty(work.NominationDisplayHtml))
                        {
                            <div class="work-nomination">
                                @Html.Raw(work.NominationDisplayHtml)
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    }

    <a asp-action="Profile" class="works-back-link">
        <span aria-hidden="true">←</span>
        Назад в профиль
    </a>
</div>


<script>
    (() => {
        // Клик по работе → общая модалка
        document.querySelectorAll('.js-open-work').forEach(button => {
            button.addEventListener('click', () => {
                window.MediaModal.openWork(
                    button.dataset.workUrl || '',
                    button.dataset.messageUrl || '',
                    Number(button.dataset.participantId || 0),
                    button.dataset.mediaType || ''
                );
            });
        });

        // Локальные даты
        document.querySelectorAll('.local-date').forEach(el => {
            const date = new Date(el.dataset.utc);
            if (Number.isNaN(date.getTime())) return;
            const pad = n => String(n).padStart(2, '0');
            if (el.dataset.format === 'full') {
                el.textContent = `${pad(date.getDate())}.${pad(date.getMonth() + 1)}.${date.getFullYear()} ${pad(date.getHours())}:${pad(date.getMinutes())}`;
            }
        });
    })();
</script>