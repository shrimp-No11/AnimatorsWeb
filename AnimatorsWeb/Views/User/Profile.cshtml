@model AnimatorsWeb.Models.UserProfileViewModel
@using AnimatorsWeb.Services

@{
    ViewData["Title"] = "Профиль";

    var currentDiscordId = User.FindFirst("discord_id")?.Value;
    bool isOwnProfile = currentDiscordId == Model.DiscordUserId.ToString();
}

<style>
    .profile-page {
        color: var(--brand-text);
        max-width: 1000px;
        margin: 0 auto;
    }

    .profile-heading {
        margin: 0 0 24px;
        font-size: clamp(1.8rem, 4vw, 2.5rem);
        font-weight: 750;
        letter-spacing: -.035em;
    }

    .profile-hero {
        display: flex;
        align-items: center;
        gap: 24px;
        padding: 28px;
        background:
            radial-gradient(
                circle at top right,
                color-mix(in srgb, var(--brand-primary) 13%, transparent),
                transparent 55%
            ),
            var(--brand-card);
        border: 1px solid color-mix(in srgb, var(--brand-text) 10%, transparent);
        border-radius: 20px;
    }

    .profile-avatar {
        display: flex;
        flex: 0 0 112px;
        align-items: center;
        justify-content: center;
        width: 112px;
        height: 112px;
        overflow: hidden;
        background: color-mix(in srgb, var(--brand-primary) 12%, var(--brand-card));
        border-radius: 50%;
    }

    .profile-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .profile-avatar-placeholder {
        color: var(--brand-primary);
        font-size: 2.5rem;
        font-weight: 750;
    }

    .profile-identity {
        min-width: 0;
    }

    .profile-name {
        margin: 0;
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 750;
        overflow-wrap: anywhere;
    }

    .profile-linked-accounts {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 12px;
    }

    .profile-account-tag {
        padding: 5px 10px;
        color: var(--brand-text);
        background: color-mix(in srgb, var(--brand-text) 7%, transparent);
        border: 1px solid color-mix(in srgb, var(--brand-text) 9%, transparent);
        border-radius: 8px;
        font-size: .82rem;
        overflow-wrap: anywhere;
    }

    .profile-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
        margin-top: 16px;
    }

    .profile-meta-text {
        color: var(--brand-text);
        opacity: .7;
        font-size: .9rem;
    }

    .profile-link-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 9px 13px;
        color: var(--brand-primary);
        background: color-mix(in srgb, var(--brand-primary) 9%, transparent);
        border: 1px solid color-mix(in srgb, var(--brand-primary) 22%, transparent);
        border-radius: 10px;
        font-size: .9rem;
        font-weight: 650;
        text-decoration: none;
        transition: background .2s, transform .2s;
    }

    .profile-link-button:hover {
        color: var(--brand-primary);
        background: color-mix(in srgb, var(--brand-primary) 15%, transparent);
        transform: translateY(-1px);
    }

    .profile-stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
        margin: 24px 0;
    }

    .profile-stat-card {
        padding: 22px 24px;
        background: var(--brand-card);
        border: 1px solid color-mix(in srgb, var(--brand-text) 10%, transparent);
        border-radius: 16px;
    }

    .profile-stat-label {
        margin: 0 0 8px;
        color: var(--brand-text);
        opacity: .7;
        font-size: .9rem;
        font-weight: 600;
    }

    .profile-stat-value {
        margin: 0;
        color: var(--brand-primary);
        font-size: clamp(2rem, 4vw, 2.6rem);
        font-weight: 800;
        line-height: 1.1;
        font-variant-numeric: tabular-nums;
    }

    .profile-wins-card {
        padding: 24px;
        background: var(--brand-card);
        border: 1px solid color-mix(in srgb, var(--brand-text) 10%, transparent);
        border-radius: 16px;
    }

    .profile-section-title {
        margin: 0 0 18px;
        font-size: 1.15rem;
        font-weight: 750;
    }

    .profile-wins-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .profile-win-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 13px 14px;
        background: color-mix(in srgb, var(--brand-text) 4%, transparent);
        border-radius: 11px;
        font-size: .92rem;
    }

    .profile-win-label {
        flex: 1;
        min-width: 0;
        line-height: 1.5;
    }

    .profile-win-value {
        color: var(--brand-primary);
        font-weight: 800;
        font-variant-numeric: tabular-nums;
    }

    .profile-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        margin-top: 24px;
    }

    .profile-works-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 12px 20px;
        color: white;
        background: var(--brand-primary);
        border: 1px solid transparent;
        border-radius: 12px;
        font-weight: 700;
        text-decoration: none;
        transition: background .2s, transform .2s;
    }

    .profile-works-button:hover {
        color: white;
        background: var(--brand-primary-hover);
        transform: translateY(-1px);
    }

    .profile-info-message {
        margin: 18px 0 0;
        padding: 12px 15px;
        color: var(--brand-text);
        opacity: .8;
        background: color-mix(in srgb, var(--brand-primary) 8%, transparent);
        border-radius: 10px;
        font-size: .9rem;
    }

    @@media (max-width: 650px) {
        .profile-hero {
            align-items: flex-start;
            gap: 16px;
            padding: 20px;
            border-radius: 16px;
        }

        .profile-avatar {
            flex-basis: 76px;
            width: 76px;
            height: 76px;
        }

        .profile-avatar-placeholder {
            font-size: 1.8rem;
        }

        .profile-stats {
            gap: 12px;
            margin: 16px 0;
        }

        .profile-stat-card {
            padding: 18px;
        }

        .profile-wins-card {
            padding: 18px;
        }

        .profile-wins-list {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 420px) {
        .profile-hero {
            flex-direction: column;
        }

        .profile-stats {
            grid-template-columns: 1fr 1fr;
        }

        .profile-stat-card {
            padding: 15px;
        }
    }
</style>

<div class="profile-page">
    <h1 class="profile-heading">Профиль</h1>

    <section class="profile-hero">
        <div class="profile-avatar">
            @if (!string.IsNullOrEmpty(Model.AvatarUrl))
            {
                <img src="@Model.AvatarUrl" alt="Аватар @Model.DisplayName" />
            }
            else
            {
                <span class="profile-avatar-placeholder" aria-hidden="true">
                    @(string.IsNullOrWhiteSpace(Model.DisplayName)
                        ? "?"
                        : Model.DisplayName.Trim().Substring(0, 1).ToUpperInvariant())
                </span>
            }
        </div>

        <div class="profile-identity">
            <h2 class="profile-name">@Model.DisplayName</h2>

            @if (Model.LinkedAccounts.Any())
            {
                <div class="profile-linked-accounts">
                    @foreach (var account in Model.LinkedAccounts)
                    {
                        <span class="profile-account-tag">@account.Name</span>
                    }
                </div>
            }

            <div class="profile-meta">
                @if (isOwnProfile)
                {
                    <a asp-controller="User"
                       asp-action="LinkedAccounts"
                       class="profile-link-button">
                        <span aria-hidden="true">🔗</span>
                        Связанные аккаунты
                    </a>
                }

                @if (Model.FirstParticipationDate > 0)
                {
                    <span class="profile-meta-text">
                        Участвует с AniJam #@Model.FirstParticipationDate
                    </span>
                }
            </div>
        </div>
    </section>

    <section class="profile-stats" aria-label="Статистика участника">
        <div class="profile-stat-card">
            <p class="profile-stat-label">Участий</p>
            <p class="profile-stat-value">@Model.ParticipationsCount</p>
        </div>

        <div class="profile-stat-card">
            <p class="profile-stat-label">Побед</p>
            <p class="profile-stat-value">@Model.WinsCount</p>
        </div>
    </section>

    <section class="profile-wins-card">
        <h3 class="profile-section-title">Статистика наград</h3>

        <ul class="profile-wins-list">
            <li class="profile-win-item">
                <span aria-hidden="true">@EmojiHelper.Star</span>
                <span class="profile-win-label">Лучшая идея</span>
                <span class="profile-win-value">@Model.IdeaWins</span>
            </li>

            <li class="profile-win-item">
                <span aria-hidden="true">@EmojiHelper.Hammer</span>
                <span class="profile-win-label">Лучшее техническое исполнение</span>
                <span class="profile-win-value">@Model.TechnicalWins</span>
            </li>

            <li class="profile-win-item">
                <span aria-hidden="true">@EmojiHelper.Medal</span>
                <span class="profile-win-label">Абсолютная победа</span>
                <span class="profile-win-value">@Model.AbsoluteVictoriesCount</span>
            </li>

            <li class="profile-win-item">
                <span aria-hidden="true">@EmojiHelper.Trophy</span>
                <span class="profile-win-label">Победа старого формата</span>
                <span class="profile-win-value">@Model.LegacyVictoriesCount</span>
            </li>

            <li class="profile-win-item">
                <span aria-hidden="true">@Html.Raw(EmojiHelper.GoldPoopHtml)</span>
                <span class="profile-win-label">Почётное упоминание <span class="profile-meta-text">(не победа)</span></span>
                <span class="profile-win-value">@Model.HonorableWins</span>
            </li>
        </ul>
    </section>

    <div class="profile-footer">
        <a asp-action="Works"
           asp-route-id="@Model.DiscordUserId"
           class="profile-works-button">
            Смотреть работы
            <span aria-hidden="true">→</span>
        </a>
    </div>

    @if (TempData["Info"] != null)
    {
        <p class="profile-info-message">@TempData["Info"]</p>
    }
</div>