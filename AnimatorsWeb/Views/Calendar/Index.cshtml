                    @foreach (var ch in Model.VoiceChannels)
                    {
                        <option value="@ch.Id">@ch.Name</option>
                    }
                </select>
                <input type="text" id="editEventLocationText" placeholder="Например: Discord VC / Zoom / площадка" />
