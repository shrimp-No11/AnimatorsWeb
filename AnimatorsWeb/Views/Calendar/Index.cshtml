    document.querySelectorAll('.cal-cell').forEach(cell => {
        cell.addEventListener('click', e => {
            if (e.target.closest('.cal-event-bar')) return;
            if (!isModerator) return;
            openCreateEventModal(cell.dataset.date, null);
        });
    });

    // ===== Drag&drop =====
    if (isModerator) {
        document.querySelectorAll('.cal-preset-item[data-preset-id]').forEach(el => {
            el.addEventListener('dragstart', e => {
                e.dataTransfer.setData('application/x-preset-id', el.dataset.presetId);
                e.dataTransfer.effectAllowed = 'copy';
            });
        });
        document.querySelectorAll('.cal-preset-item[data-pattern-id]').forEach(el => {
            el.addEventListener('dragstart', e => {
                e.dataTransfer.setData('application/x-pattern-id', el.dataset.patternId);
                e.dataTransfer.effectAllowed = 'copy';
            });
        });

        document.querySelectorAll('.cal-cell').forEach(cell => {
            cell.addEventListener('dragover', e => {
                const hasP = e.dataTransfer.types.includes('application/x-preset-id');
                const hasPat = e.dataTransfer.types.includes('application/x-pattern-id');
                const hasEv = e.dataTransfer.types.includes('application/x-event-id');
                if (!hasP && !hasPat && !hasEv) return;
                e.preventDefault();
                e.dataTransfer.dropEffect = hasEv ? 'move' : 'copy';
                cell.style.background = 'color-mix(in srgb, var(--brand-primary) 12%, var(--brand-card))';
            });
            cell.addEventListener('dragleave', () => { cell.style.background = ''; });
            cell.addEventListener('drop', async e => {
                e.preventDefault();
                cell.style.background = '';
                const dateMsk = cell.dataset.date;
                if (!dateMsk) return;

                const eventIdStr = e.dataTransfer.getData('application/x-event-id');
                if (eventIdStr) {
                    const eventId = parseInt(eventIdStr);
                    const evStartUtc = e.dataTransfer.getData('application/x-event-start');
                    if (!eventId || !evStartUtc) return;

                    const d = new Date(evStartUtc);
                    const oldLocalDate = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
                    if (oldLocalDate === dateMsk) return;

                    const oldD = new Date(oldLocalDate + 'T00:00:00');
                    const newD = new Date(dateMsk + 'T00:00:00');
                    const daysDelta = Math.round((newD - oldD) / (1000 * 60 * 60 * 24));
                    if (daysDelta === 0) return;

                    const sign = daysDelta > 0 ? '+' : '';

                    try {
                        const r = await fetch('/Calendar/MoveEvent', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: new URLSearchParams({ eventId, daysDelta })
                        });
                        const data = await r.json();
                        if (data.success) window.location.reload();
                        else alert(data.error || 'Ошибка');
                    } catch { alert('Сетевая ошибка'); }
                    return;
                }

                const presetIdStr = e.dataTransfer.getData('application/x-preset-id');
                if (presetIdStr) {
                    const presetId = parseInt(presetIdStr);
                    if (presetId) await createEventFromPresetDirect(presetId, dateMsk);
                    return;
                }
                const patternIdStr = e.dataTransfer.getData('application/x-pattern-id');
                if (patternIdStr) {
                    const patternId = parseInt(patternIdStr);
                    if (!patternId) return;
                    if (!confirm('Разместить паттерн начиная с этой даты?')) return;
                    try {
                        const r = await fetch('/Calendar/PlacePattern', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: new URLSearchParams({ patternId, dateMsk })
                        });
                        const data = await r.json();
                        if (data.success) window.location.reload();
                        else alert(data.error || 'Ошибка');
                    } catch { alert('Сетевая ошибка'); }
                }
            });
        });
    }
