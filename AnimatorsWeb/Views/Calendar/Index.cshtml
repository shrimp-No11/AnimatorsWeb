@model AnimatorsWeb.Models.CalendarPageViewModel
@using AnimatorsWeb.Models

@{
    var monthNames = new[]
    {
        "Январь", "Февраль", "Март", "Апрель", "Май", "Июнь",
        "Июль", "Август", "Сентябрь", "Октябрь", "Ноябрь", "Декабрь"
    };
    var dayNames = new[] { "Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс" };

    var prevMonth = Model.Month == 1 ? (Model.Year - 1, 12) : (Model.Year, Model.Month - 1);
    var nextMonth = Model.Month == 12 ? (Model.Year + 1, 1) : (Model.Year, Model.Month + 1);
    ViewData["Title"] = $"Календарь — {monthNames[Model.Month - 1]} {Model.Year}";
}

<style>
    .cal-page {
        --cal-line: color-mix(in srgb, var(--brand-text) 12%, transparent);
        --cal-muted: color-mix(in srgb, var(--brand-text) 60%, transparent);
        max-width: 1400px;
        margin: 0 auto;
        padding: 20px 0 60px;
    }

        .cal-page.is-moderator {
            display: grid;
            grid-template-columns: 1fr 320px;
            gap: 20px;
            align-items: start;
        }

    .cal-main {
        min-width: 0;
    }

    .cal-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .cal-title {
        margin: 0;
        font-size: 28px;
        font-weight: 800;
    }

    .cal-nav {
        display: flex;
        gap: 6px;
        margin-left: auto;
    }

        .cal-nav a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 36px;
            height: 36px;
            padding: 0 12px;
            border-radius: 8px;
            border: 1px solid var(--cal-line);
            background: var(--brand-card);
            color: var(--brand-text);
            text-decoration: none;
            font-weight: 700;
            font-size: 14px;
        }

            .cal-nav a:hover {
                border-color: var(--brand-primary);
                color: var(--brand-primary);
            }

    .cal-grid-wrap {
        border: 1px solid var(--cal-line);
        border-radius: 12px;
        overflow: hidden;
        background: var(--brand-card);
    }

    .cal-grid-head {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        background: color-mix(in srgb, var(--brand-primary) 8%, var(--brand-card));
        border-bottom: 1px solid var(--cal-line);
    }

        .cal-grid-head > div {
            padding: 10px 8px;
            text-align: center;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--cal-muted);
        }

    .cal-grid {
        display: flex;
        flex-direction: column;
    }

    .cal-week {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        grid-template-rows: 24px repeat(1, minmax(0, 1fr));
        min-height: 100px;
        border-bottom: 1px solid var(--cal-line);
        position: relative;
        isolation: isolate;
    }

        .cal-week:last-child {
            border-bottom: none;
        }

    .cal-cell {
        grid-row: 1 / -1;
        min-width: 0;
        padding: 4px 6px;
        border-right: 1px solid var(--cal-line);
        position: relative;
        z-index: 1;
        background: var(--brand-card);
        cursor: pointer;
    }

        .cal-cell:nth-child(7n) {
            border-right: none;
        }

        .cal-cell.other-month {
            background: color-mix(in srgb, var(--brand-bg) 60%, var(--brand-card));
        }

        .cal-cell.today {
            background: color-mix(in srgb, var(--brand-primary) 4%, var(--brand-card));
        }

    .cal-day-num {
        font-size: 11px;
        font-weight: 700;
        color: var(--cal-muted);
        margin-bottom: 2px;
    }

    .cal-cell.today .cal-day-num {
        color: var(--brand-primary);
    }

    .cal-event-bar {
        cursor: grab;
        background: color-mix(in srgb, var(--ev-accent, var(--brand-primary)) 15%, var(--brand-card));
        border-left: 3px solid var(--ev-accent, var(--brand-primary));
        border-radius: 4px;
        margin: 2px 4px;
        padding: 3px 8px;
        font-size: 12px;
        line-height: 1.25;
        color: var(--brand-text);
        cursor: pointer;
        display: flex;
        flex-direction: column;
        gap: 1px;
        min-width: 0;
        min-height: 0;
        overflow: hidden;
        z-index: 2;
        position: relative;
        box-sizing: border-box;
    }

        .cal-event-bar:active {
            cursor: grabbing;
        }

        .cal-event-bar:hover {
            background: color-mix(in srgb, var(--ev-accent, var(--brand-primary)) 24%, var(--brand-card));
        }

    .cal-event-time {
        font-size: 10px;
        font-weight: 700;
        color: var(--ev-accent, var(--brand-primary));
        line-height: 1.2;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .cal-event-title {
        font-size: 12px;
        line-height: 1.25;
        color: var(--brand-text);
        white-space: normal;
        overflow-wrap: anywhere;
        word-break: break-word;
        min-width: 0;
    }

    .cal-event-bar.color-primary {
        --ev-accent: var(--brand-primary);
    }

    .cal-event-bar.color-accent {
        --ev-accent: var(--brand-accent);
    }

    .cal-event-bar.color-hover {
        --ev-accent: var(--brand-primary-hover);
    }

    .cal-event-bar.color-text {
        --ev-accent: var(--brand-text);
    }

    .cal-event-bar.color-bg {
        --ev-accent: var(--brand-bg);
    }

    .cal-event-bar.local {
        border-left-style: dashed;
    }

    .preset-color-swatch {
        transition: border-color 0.15s, transform 0.15s;
    }

    input[name="presetColor"]:checked + .preset-color-swatch {
        border-color: var(--brand-text);
        transform: scale(1.1);
    }
    /*сомнительно */
        .cal-event-bar .ev-time {
            color: var(--brand-primary);
            font-weight: 700;
            margin-right: 4px;
        }

    .cal-sidebar {
        position: sticky;
        top: 80px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .cal-sidebar-section {
        border: 1px solid var(--cal-line);
        border-radius: 12px;
        padding: 14px;
        background: var(--brand-card);
    }

        .cal-sidebar-section h3 {
            margin: 0 0 10px;
            font-size: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .cal-sidebar-section h3 button {
                padding: 3px 10px;
                border-radius: 6px;
                border: 1px solid var(--brand-primary);
                background: var(--brand-primary);
                color: var(--brand-bg);
                font-size: 12px;
                font-weight: 600;
                cursor: pointer;
            }

    .cal-preset-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 10px;
        border-radius: 8px;
        background: color-mix(in srgb, var(--brand-bg) 60%, var(--brand-card));
        border: 1px solid var(--cal-line);
        margin-bottom: 6px;
        font-size: 13px;
        cursor: pointer;
        transition: border-color .15s, transform .15s;
    }

        .cal-preset-item:hover {
            border-color: var(--brand-primary);
            transform: translateX(2px);
        }

        .cal-preset-item .info {
            flex: 1;
            min-width: 0;
        }

        .cal-preset-item .name {
            font-weight: 700;
        }

        .cal-preset-item .meta {
            font-size: 11px;
            color: var(--cal-muted);
        }

        .cal-preset-item .del {
            flex-shrink: 0;
            width: 22px;
            height: 22px;
            border: none;
            background: transparent;
            color: var(--cal-muted);
            cursor: pointer;
            border-radius: 4px;
            font-size: 14px;
            line-height: 1;
        }

            .cal-preset-item .del:hover {
                background: color-mix(in srgb, var(--brand-primary) 12%, var(--brand-card));
                color: var(--brand-primary);
            }

    .cal-modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 3000;
        background: color-mix(in srgb, var(--brand-text) 68%, transparent);
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

        .cal-modal.is-open {
            display: flex;
        }

    .cal-modal-content {
        background: var(--brand-card);
        border-radius: 12px;
        padding: 24px;
        max-width: 560px;
        width: 100%;
        max-height: 90vh;
        overflow-y: auto;
    }

        .cal-modal-content h3 {
            margin-top: 0;
        }

        .cal-modal-content label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .cal-modal-content input[type=text],
        .cal-modal-content input[type=number],
        .cal-modal-content input[type=time],
        .cal-modal-content input[type=date],
        .cal-modal-content input[type=datetime-local],
        .cal-modal-content textarea,
        .cal-modal-content select {
            width: 100%;
            box-sizing: border-box;
            padding: 8px 10px;
            border: 1px solid var(--cal-line);
            border-radius: 6px;
            margin-bottom: 12px;
            font-size: 14px;
            background: var(--brand-bg);
            color: var(--brand-text);
        }

    .cal-modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 16px;
    }

        .cal-modal-actions button {
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
        }

        .cal-modal-actions .cancel {
            background: var(--brand-bg);
            border: 1px solid var(--cal-line);
        }

        .cal-modal-actions .save {
            background: var(--brand-primary);
            color: var(--brand-bg);
            border: 1px solid var(--brand-primary);
        }

        .cal-modal-actions .del {
            background: var(--brand-bg);
            color: var(--brand-primary);
            border: 1px solid var(--brand-primary);
        }

    .cal-error {
        color: var(--brand-primary);
        font-size: 13px;
        padding: 8px 12px;
        background: color-mix(in srgb, var(--brand-primary) 12%, var(--brand-card));
        border-radius: 6px;
        margin-bottom: 12px;
        display: none;
    }

    @@media (max-width: 1000px) {
        .cal-page.is-moderator {
            grid-template-columns: 1fr;
        }

        .cal-sidebar {
            position: static;
        }
    }
</style>

<div class="cal-page @(Model.IsModerator ? "is-moderator" : "")">
    <div class="cal-main">
        <div class="cal-header">
            <h1 class="cal-title">@monthNames[Model.Month - 1] @Model.Year</h1>
            <div class="cal-nav">
                <a asp-action="Index" asp-route-year="@prevMonth.Item1" asp-route-month="@prevMonth.Item2">←</a>
                <a asp-action="Index">Сегодня</a>
                <a asp-action="Index" asp-route-year="@nextMonth.Item1" asp-route-month="@nextMonth.Item2">→</a>
            </div>
        </div>

        <div class="cal-grid-wrap">
            <div class="cal-grid-head">
                @foreach (var d in dayNames)
                {
                    <div>@d</div>
                }
            </div>
            <div class="cal-grid" id="calGrid">
                @for (int w = 0; w < 6; w++)
                {
                    <div class="cal-week" data-week="@w">
                        @for (int d = 0; d < 7; d++)
                        {
                            var dayIdx = w * 7 + d;
                            if (dayIdx >= Model.Days.Count) { continue; }
                            var day = Model.Days[dayIdx];
                            var classes = "cal-cell";
                            if (!day.IsCurrentMonth) classes += " other-month";
                            if (day.IsToday) classes += " today";
                            <div class="@classes" data-date="@day.DateMsk.ToString("yyyy-MM-dd")" style="grid-column: @(d + 1);">
                                <div class="cal-day-num">@day.DateMsk.Day</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @if (Model.IsModerator)
    {
        <aside class="cal-sidebar">
            <div class="cal-sidebar-section" style="border-color: var(--brand-primary);">
                <h3>Discord</h3>
                <p style="color: var(--cal-muted); font-size: 13px; margin: 0 0 10px;">
                    Сохранить и отправить в Discord
                </p>
                <button type="button" onclick="previewApply()" class="btn btn-primary" style="width: 100%;">
                    🔄 Применить
                </button>
            </div>
            <div class="cal-sidebar-section">
                <h3>
                    Пресеты
                    <button type="button" onclick="openPresetModal(0)">+ Новый</button>
                </h3>
                <div id="presetList">
                    @if (!Model.Presets.Any())
                    {
                        <p style="color: var(--cal-muted); font-size: 13px; margin: 0;">Пресетов пока нет.</p>
                    }
                    else
                    {
                        @foreach (var p in Model.Presets)
                        {
                            <div class="cal-preset-item" data-preset-id="@p.Id" draggable="true"
                                 data-name="@p.Name"
                                 data-title="@p.DefaultTitle"
                                 data-description="@(p.DefaultDescription ?? "")"
                                 data-duration="@p.DurationHours"
                                 data-location="@(p.Location ?? "")"
                                 data-create-in-discord="@p.CreateInDiscord.ToString().ToLower()"
                                 data-is-recurring="@p.IsRecurring.ToString().ToLower()"
                                 data-recurrence-frequency="@(p.RecurrenceFrequency?.ToString() ?? "")"
                                 data-start-time-utc="@(p.DefaultStartTimeUtc.HasValue ? p.DefaultStartTimeUtc.Value.ToString(@"hh\:mm") : "")"
                                 data-color="@(p.Color ?? "primary")">
                                

                                <div class="info" onclick="openPresetModal(@p.Id)">
                                    <div class="name">@p.Name</div>
                                    <div class="meta">@p.DurationHours ч. · @p.DefaultTitle</div>
                                </div>
                                <button type="button" class="del" onclick="deletePreset(@p.Id, '@p.Name')" title="Удалить">×</button>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="cal-sidebar-section">
                <h3>
                    Паттерны
                    <button type="button" onclick="window.location.href='/Calendar/PatternEditor'">+ Новый</button>
                </h3>
                @if (!Model.Patterns.Any())
                {
                    <p style="color: var(--cal-muted); font-size: 13px; margin: 0;">Паттернов пока нет.</p>
                }
                else
                {
                    @foreach (var pat in Model.Patterns)
                    {
                        <div class="cal-preset-item" data-pattern-id="@pat.Id" draggable="true">
                            <div class="info" onclick="window.location.href='/Calendar/PatternEditor/@pat.Id'">
                                <div class="name">@pat.Name</div>
                                <div class="meta">@pat.CycleWeeksCount нед.</div>
                            </div>
                            <button type="button" class="del" onclick="deletePattern(@pat.Id, '@pat.Name')" title="Удалить">×</button>
                        </div>
                    }
                }
            </div>
        </aside>
    }

    @if (Model.IsModerator)
    {
        <div id="applyModal" class="cal-modal">
            <div class="cal-modal-content" style="max-width: 700px;">
                <h3>Синхронизация с Discord</h3>
                <div id="applyLoading" style="color: var(--cal-muted);">Загрузка...</div>
                <div id="applyResult" style="display: none;">
                    <div style="display: flex; gap: 24px; margin-bottom: 16px; flex-wrap: wrap;">
                        <div>Создать: <b id="applyCreateCount" style="color: var(--brand-primary);">0</b></div>
                        <div>Обновить: <b id="applyUpdateCount" style="color: var(--brand-accent);">0</b></div>
                        <div>Удалить: <b id="applyDeleteCount" style="color: var(--brand-primary);">0</b></div>
                    </div>
                    <div id="applyItemsList" style="max-height: 400px; overflow-y: auto; font-size: 13px;"></div>
                    <div class="cal-modal-actions" style="margin-top: 16px;">
                        <button type="button" class="cancel" onclick="closeApplyModal()">Отмена</button>
                        <button type="button" class="save" onclick="doApply()" id="applyConfirmBtn">Применить</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Модалка пресета -->
<div id="presetModal" class="cal-modal">
    <div class="cal-modal-content">
        <h3 id="presetModalTitle">Новый пресет</h3>
        <div id="presetError" class="cal-error"></div>
        <input type="hidden" id="presetId" value="0" />

        <label>Заголовок события</label>
        <input type="text" id="presetDefaultTitle" placeholder="Название" />

        <label>Описание</label>
        <textarea id="presetDefaultDescription" rows="2"></textarea>

        <label style="display: flex; align-items: center; gap: 8px; margin-top: 8px;">
            <input type="checkbox" id="presetCreateInDiscord" checked />
            Создавать событие в Discord
        </label>

        <label>Время начала по умолчанию</label>
        <input type="time" id="presetDefaultStartTime" />

        <label>Цвет события</label>
        <div style="display: flex; gap: 10px; margin-bottom: 12px;">
            <label style="cursor: pointer; display: inline-flex;">
                <input type="radio" name="presetColor" value="primary" checked style="display: none;" />
                <span class="preset-color-swatch" data-color="primary" style="width: 32px; height: 32px; border-radius: 6px; background: var(--brand-primary); border: 2px solid transparent;"></span>
            </label>
            <label style="cursor: pointer; display: inline-flex;">
                <input type="radio" name="presetColor" value="accent" style="display: none;" />
                <span class="preset-color-swatch" data-color="accent" style="width: 32px; height: 32px; border-radius: 6px; background: var(--brand-accent); border: 2px solid transparent;"></span>
            </label>
            <label style="cursor: pointer; display: inline-flex;">
                <input type="radio" name="presetColor" value="hover" style="display: none;" />
                <span class="preset-color-swatch" data-color="hover" style="width: 32px; height: 32px; border-radius: 6px; background: var(--brand-primary-hover); border: 2px solid transparent;"></span>
            </label>
            <label style="cursor: pointer; display: inline-flex;">
                <input type="radio" name="presetColor" value="text" style="display: none;" />
                <span class="preset-color-swatch" data-color="text" style="width: 32px; height: 32px; border-radius: 6px; background: var(--brand-text); border: 2px solid transparent;"></span>
            </label>

        </div>

        <label>Длительность (часов)</label>
        <input type="number" id="presetDuration" value="2" min="1" max="720" />

        <label>Голосовой канал</label>
        <select id="presetLocation">
            <option value="">— Не указано —</option>
            @foreach (var ch in Model.VoiceChannels)
            {
                <option value="@ch.Id">@ch.Name</option>
            }
        </select>
        <input type="text" id="presetLocationText" placeholder="Или произвольный текст" style="display: none;" />

        <div class="cal-modal-actions">
            <button type="button" class="cancel" onclick="closePresetModal()">Отмена</button>
            <button type="button" class="save" onclick="savePreset()" id="presetSaveBtn">Сохранить</button>
        </div>
    </div>
</div>

@if (Model.IsModerator)
{
    <div id="createEventModal" class="cal-modal">
        <div class="cal-modal-content">
            <h3>Создать событие</h3>
            <div id="createEventError" class="cal-error"></div>
            <input type="hidden" id="createEventDate" />

            <label>Пресет</label>
            <select id="createEventPreset">
                @foreach (var p in Model.Presets)
                {
                    <option value="@p.Id" data-start-time-utc="@(p.DefaultStartTimeUtc.HasValue ? p.DefaultStartTimeUtc.Value.ToString(@"hh\:mm") : "")">@p.Name</option>
                }
            </select>

            <label>Время начала</label>
            <input type="time" id="createEventTime" value="20:00" />

            <div class="cal-modal-actions">
                <button type="button" class="cancel" onclick="closeCreateEventModal()">Отмена</button>
                <button type="button" class="save" onclick="createEvent()" id="createEventBtn">Создать</button>
            </div>
        </div>
    </div>

    <div id="editEventModal" class="cal-modal">
        <div class="cal-modal-content">
            <h3>Редактировать событие</h3>
            <div id="editEventError" class="cal-error"></div>
            <input type="hidden" id="editEventId" />

            <label>Название</label>
            <input type="text" id="editEventTitle" />

            <label>Описание</label>
            <textarea id="editEventDescription" rows="3"></textarea>

            <label style="display: flex; align-items: center; gap: 8px; margin-top: 8px;">
                <input type="checkbox" id="editEventIsRecurring" onchange="onEditEventRecurringChange()" />
                Повторяющееся событие
            </label>

            <div id="editEventRecurringFields" style="display: none;">
                <label>Как часто</label>
                <select id="editEventRecurrenceFrequency">
                    <option value="2">Каждую неделю</option>
                    <option value="3">Каждый день</option>
                    <option value="1">Каждый месяц</option>
                </select>
            </div>

            <label>Начало</label>
            <input type="datetime-local" id="editEventStart" />

            <label>Окончание</label>
            <input type="datetime-local" id="editEventEnd" />

            <label>Голосовой канал</label>
            <select id="editEventLocationSelect">
                <option value="">— Произвольное значение —</option>
                @foreach (var ch in Model.VoiceChannels)
                {
                    <option value="@ch.Id">@ch.Name</option>
                }
            </select>
            <input type="text" id="editEventLocationText" placeholder="Произвольное значение" style="display: none;" />

            <div class="cal-modal-actions">
                <button type="button" class="del" onclick="deleteSeriesEvents()" id="editEventDeleteSeriesBtn" style="display:none;">Удалить все этой серии</button>
                <button type="button" class="cancel" onclick="closeEditEventModal()">Отмена</button>
                <button type="button" class="save" onclick="updateEvent()" id="editEventSaveBtn">Сохранить</button>
                <button type="button" class="del" onclick="deleteEvent()" id="editEventDeleteBtn">Удалить</button>
            </div>
        </div>
    </div>
}

<script>
    const isModerator = @(Model.IsModerator ? "true" : "false");
    const voiceChannels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.VoiceChannels.Select(c => new { id = c.Id.ToString(), name = c.Name })
        ));

    function escapeHtml(value) {
        return String(value ?? '').replace(/[&<>"']/g, ch => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
        })[ch]);
    }

    function utcTimeToLocal(utcTime) {
        if (!utcTime) return '';
        const [h, m] = utcTime.split(':').map(Number);
        const d = new Date(Date.UTC(2000, 0, 1, h, m));
        return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
    }

    function localTimeToUtc(localTime) {
        if (!localTime) return '';
        const [h, m] = localTime.split(':').map(Number);
        const d = new Date(2000, 0, 1, h, m);
        return `${String(d.getUTCHours()).padStart(2, '0')}:${String(d.getUTCMinutes()).padStart(2, '0')}`;
    }

    function utcToLocalInput(utcStr) {
        const d = new Date(utcStr);
        if (isNaN(d)) return '';
        const p = n => String(n).padStart(2, '0');
        return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`;
    }

