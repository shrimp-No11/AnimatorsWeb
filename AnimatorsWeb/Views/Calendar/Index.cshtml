            <div class="cal-field-group">
                <label>Когда</label>
                <div style="display:flex; gap:8px;">
                    <input type="datetime-local" id="editEventStart" style="flex:1;" />
                    <input type="datetime-local" id="editEventEnd" style="flex:1;" />
