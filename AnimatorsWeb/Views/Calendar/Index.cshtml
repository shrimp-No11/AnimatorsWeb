    async function createEvent() {
        const presetId = parseInt(document.getElementById('createEventPreset').value) || 0;
        const dateLocal = document.getElementById('createEventDate').value;
        const timeLocal = document.getElementById('createEventTime').value || '20:00';
        const err = document.getElementById('createEventError');
