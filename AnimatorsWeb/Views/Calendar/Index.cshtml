            <div class="cal-modal-actions">
                <button type="button" class="cancel" onclick="closeEditEventModal()">Отмена</button>
                <button type="button" class="save" onclick="updateEvent()" id="editEventSaveBtn">Сохранить</button>
                <button type="button" class="secondary" onclick="editSeriesPreset()" id="editEventEditSeriesBtn" style="display:none;">Настроить серию</button>
                <button type="button" class="secondary" onclick="makeEventSeries()" id="editEventMakeSeriesBtn" style="display:none;">Продлить</button>
                <button type="button" class="del" onclick="cancelAllOccurrences()" id="editEventCancelAllBtn" style="display:none;">Отменить все повторения</button>
                <button type="button" class="del" onclick="deleteEvent()" id="editEventDeleteBtn">Убрать с сетки</button>
            </div>
        </div>
    </div>
    
}

@Html.AntiForgeryToken()
<script>
    // Сколько POST-запросов календаря выполняется прямо сейчас.
    // Пока идёт запрос, страницу не перезагружаем (иначе оборвём его).
    let calRequestsInFlight = 0;

    // Все POST-запросы календаря автоматически несут CSRF-токен.
    (function () {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const originalFetch = window.fetch;
        window.fetch = async function (input, init) {
            const url = typeof input === 'string' ? input : input.url;
            const method = ((init && init.method) || (input && input.method) || 'GET').toUpperCase();
            if (token && method === 'POST' && url && url.startsWith('/Calendar/')) {
                init = init || {};
                const headers = new Headers(init.headers || {});
                headers.set('RequestVerificationToken', token);
                init.headers = headers;
            }
            // Не даём повторно нажать кнопку, пока запрос выполняется.
            const pressed = document.activeElement;
            const busyButton = pressed && pressed.tagName === 'BUTTON' ? pressed : null;
            if (busyButton) busyButton.disabled = true;
            const isPost = method !== 'GET';
            if (isPost) calRequestsInFlight++;
            try {
                return await originalFetch(input, init);
            } finally {
                if (isPost) calRequestsInFlight--;
                if (busyButton) busyButton.disabled = false;
            }
        };
    })();

    const isModerator = @(Model.IsModerator ? "true" : "false");
    const voiceChannels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.VoiceChannels.Select(c => new { id = c.Id.ToString(), name = c.Name })
        ));

    function escapeHtml(value) {
        return String(value ?? '').replace(/[&<>"']/g, ch => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
        })[ch]);
    }

    function utcTimeToLocal(utcTime) {
        if (!utcTime) return '';
        const [h, m] = utcTime.split(':').map(Number);
        const d = new Date(Date.UTC(2000, 0, 1, h, m));
        return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
    }

    function localTimeToUtc(localTime) {
        if (!localTime) return '';
        const [h, m] = localTime.split(':').map(Number);
        const d = new Date(2000, 0, 1, h, m);
        return `${String(d.getUTCHours()).padStart(2, '0')}:${String(d.getUTCMinutes()).padStart(2, '0')}`;
    }

    function utcToLocalInput(utcStr) {
        const d = new Date(utcStr);
        if (isNaN(d)) return '';
        const p = n => String(n).padStart(2, '0');
        return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`;
    }

    // ===== Пресеты =====
    const presetLocationSelect = document.getElementById('presetLocation');
    const presetLocationText = document.getElementById('presetLocationText');
    if (presetLocationSelect && presetLocationText) {
        presetLocationSelect.addEventListener('change', () => {
            if (presetLocationSelect.value) {
                presetLocationText.style.display = 'none';
                presetLocationText.value = '';
            } else {
                presetLocationText.style.display = 'block';
            }
        });
    }
    function onPresetSeriesChange() {
        const cb = document.getElementById('presetIsDiscordSeries');
        const createCb = document.getElementById('presetCreateInDiscord');
        const warn = document.getElementById('presetSeriesWarning');
        if (!cb) return;

        if (cb.checked) {
            if (createCb) { createCb.checked = true; createCb.disabled = true; }
            if (warn) warn.style.display = 'block';
        } else {
            if (createCb) createCb.disabled = cb.disabled;
            if (warn) warn.style.display = 'none';
        }
    }
    function openPresetModal(id) {
        const modal = document.getElementById('presetModal');
        if (!modal) return;
        const item = id ? document.querySelector(`.cal-preset-item[data-preset-id="${id}"]`) : null;

        document.getElementById('presetId').value = id || 0;
        document.getElementById('presetModalTitle').textContent = id ? 'Редактировать пресет' : 'Новый пресет';
        document.getElementById('presetDefaultTitle').value = item?.dataset.title || '';
        document.getElementById('presetDefaultDescription').value = item?.dataset.description || '';
        document.getElementById('presetDuration').value = item?.dataset.duration || 2;
        document.getElementById('presetCreateInDiscord').checked = item ? item.dataset.createInDiscord === 'true' : true;
        const seriesCb = document.getElementById('presetIsDiscordSeries');
        if (seriesCb) {
            seriesCb.checked = item?.dataset.isDiscordSeries === 'true';
            seriesCb.disabled = !!item?.dataset.discordSeriesEventId;
        }
        const seriesWarn = document.getElementById('presetSeriesWarning');
        if (seriesWarn) seriesWarn.style.display = seriesCb?.checked ? 'block' : 'none';
        const createCb = document.getElementById('presetCreateInDiscord');
        if (createCb) createCb.disabled = seriesCb?.checked || seriesCb?.disabled;
        document.getElementById('presetDefaultStartTime').value = item?.dataset.startTimeUtc ? utcTimeToLocal(item.dataset.startTimeUtc) : '';
        const intervalInput = document.getElementById('presetRecurrenceInterval');
        if (intervalInput) intervalInput.value = String(item?.dataset.recurrenceInterval || 1);
        const coverUrlInput = document.getElementById('presetCoverUrl');
        if (coverUrlInput) coverUrlInput.value = item?.dataset.coverUrl || '';
        const coverFileInput = document.getElementById('presetCoverFile');
        if (coverFileInput) coverFileInput.value = '';
        const coverPreview = document.getElementById('presetCoverPreview');
        if (coverPreview) {
            const coverUrl = item?.dataset.coverUrl
                || (item?.dataset.coverFile ? '/uploads/covers/' + item.dataset.coverFile : '');
            if (coverUrl) { coverPreview.src = coverUrl; coverPreview.style.display = 'block'; }
            else { coverPreview.removeAttribute('src'); coverPreview.style.display = 'none'; }
        }

        const colorVal = item?.dataset.color || 'primary';
        document.querySelectorAll('input[name="presetColor"]').forEach(el => {
            el.checked = el.value === colorVal;
        });

        const loc = item?.dataset.location || '';
        const isCh = voiceChannels.some(c => c.id === loc);
        if (isCh) {
            presetLocationSelect.value = loc;
            presetLocationText.style.display = 'none';
            presetLocationText.value = '';
        } else if (loc) {
            presetLocationSelect.value = '';
            presetLocationText.value = loc;
            presetLocationText.style.display = 'block';
        } else {
            presetLocationSelect.value = '';
            presetLocationText.value = '';
            presetLocationText.style.display = 'none';
        }
        document.getElementById('presetError').style.display = 'none';
        modal.classList.add('is-open');
    }

    function closePresetModal() {
        document.getElementById('presetModal')?.classList.remove('is-open');
    }

    async function savePreset() {
        const id = parseInt(document.getElementById('presetId').value) || 0;
        const defaultTitle = document.getElementById('presetDefaultTitle').value.trim();
        const defaultDescription = document.getElementById('presetDefaultDescription').value;
        const durationHours = parseInt(document.getElementById('presetDuration').value) || 0;
        let presetLocation = presetLocationSelect.value;
        if (!presetLocation && presetLocationText.value.trim()) presetLocation = presetLocationText.value.trim();
        const createInDiscord = document.getElementById('presetCreateInDiscord')?.checked ?? true;
        const isDiscordSeries = document.getElementById('presetIsDiscordSeries')?.checked ?? false;
        const defaultStartTimeUtc = localTimeToUtc(document.getElementById('presetDefaultStartTime').value || '');
        const color = document.querySelector('input[name="presetColor"]:checked')?.value || 'primary';

        const err = document.getElementById('presetError');
        err.style.display = 'none';
        if (!defaultTitle) { err.textContent = 'Название обязательно'; err.style.display = 'block'; return; }
        if (!durationHours || durationHours < 1 || durationHours > 720) {
            err.textContent = 'Длительность от 1 до 720 часов'; err.style.display = 'block'; return;
        }

        const btn = document.getElementById('presetSaveBtn');
        btn.disabled = true; btn.textContent = 'Сохраняю...';
        try {
            const form = new FormData();
            form.set('id', String(id));
            form.set('name', defaultTitle);
            form.set('defaultTitle', defaultTitle);
            form.set('defaultDescription', defaultDescription || '');
            form.set('durationHours', String(durationHours));
            form.set('location', presetLocation || '');
            form.set('createInDiscord', String(createInDiscord));
            form.set('isDiscordSeries', String(isDiscordSeries));
            form.set('defaultStartTimeUtc', defaultStartTimeUtc || '');
            form.set('color', color);
            form.set('coverImageUrl', document.getElementById('presetCoverUrl').value.trim());
            form.set('recurrenceInterval', document.getElementById('presetRecurrenceInterval')?.value || '1');
            const fileInput = document.getElementById('presetCoverFile');
            if (fileInput && fileInput.files.length) form.set('coverImage', fileInput.files[0]);

            const r = await fetch('/Calendar/SavePreset', {
                method: 'POST',
                body: form
            });
            const data = await r.json();
            if (data.success) window.location.reload();
            else { err.textContent = data.error || 'Ошибка'; err.style.display = 'block'; }
        } catch { err.textContent = 'Сетевая ошибка'; err.style.display = 'block'; }
        finally { btn.disabled = false; btn.textContent = 'Сохранить'; }
    }

    async function deletePreset(id, name) {
        if (!confirm(`Удалить пресет «${name}»? Все его события на календаре тоже будут удалены.`)) return;
        try {
            const r = await fetch('/Calendar/DeletePreset', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ id })
            });
            const data = await r.json();
            if (data.success) window.location.reload();
            else alert(data.error || 'Ошибка');
        } catch { alert('Сетевая ошибка'); }
    }

    // ===== Создание события =====
    function openCreateEventModal(dateMsk, presetId) {
        const modal = document.getElementById('createEventModal');
        if (!modal) return;
        const presetSelect = document.getElementById('createEventPreset');
        if (!presetSelect || presetSelect.options.length === 0) {
            alert('Сначала создайте хотя бы один пресет.');
            return;
        }
        document.getElementById('createEventDate').value = dateMsk;
        if (presetId) presetSelect.value = String(presetId);
        const opt = presetSelect.options[presetSelect.selectedIndex];
        const presetStartUtc = opt?.dataset.startTimeUtc;
        document.getElementById('createEventTime').value = presetStartUtc ? utcTimeToLocal(presetStartUtc) : '20:00';
        document.getElementById('createEventError').style.display = 'none';
        modal.classList.add('is-open');
    }

    function closeCreateEventModal() {
        document.getElementById('createEventModal')?.classList.remove('is-open');
    }

    async function createEvent() {
        const presetId = parseInt(document.getElementById('createEventPreset').value) || 0;
        const dateLocal = document.getElementById('createEventDate').value;
        const timeLocal = document.getElementById('createEventTime').value || '20:00';
        const err = document.getElementById('createEventError');
        const btn = document.getElementById('createEventBtn');
        err.style.display = 'none';
        if (!presetId) { err.textContent = 'Выберите пресет'; err.style.display = 'block'; return; }
        if (!dateLocal) { err.textContent = 'Укажите дату'; err.style.display = 'block'; return; }

        const [y, m, d] = dateLocal.split('-').map(Number);
        const [hh, mm] = timeLocal.split(':').map(Number);
        const startLocal = new Date(y, m - 1, d, hh, mm);
        const startUtc = startLocal.toISOString();

        btn.disabled = true; btn.textContent = 'Создаю...';
        try {
            const r = await fetch('/Calendar/CreateEvent', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ presetId, startUtc, dateMsk: dateLocal })
            });
            const data = await r.json();
            if (data.success) window.location.reload();
            else { err.textContent = data.error || 'Ошибка'; err.style.display = 'block'; }
        } catch { err.textContent = 'Сетевая ошибка'; err.style.display = 'block'; }
        finally { btn.disabled = false; btn.textContent = 'Создать'; }
    }

    async function createEventFromPresetDirect(presetId, dateMsk) {
        const opt = document.querySelector(`#createEventPreset option[value="${presetId}"]`);
        const startTimeUtc = opt?.dataset.startTimeUtc || '17:00';
        const localTimeStr = utcTimeToLocal(startTimeUtc);
        const [lh, lm] = localTimeStr.split(':').map(Number);
        const [y, m, d] = dateMsk.split('-').map(Number);
        const startLocal = new Date(y, m - 1, d, lh, lm);
        const startUtcIso = startLocal.toISOString();

        try {
            const r = await fetch('/Calendar/CreateEvent', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ presetId, startUtc: startUtcIso, dateMsk })
            });
            const data = await r.json();
            if (data.success) window.location.reload();
            else alert(data.error || 'Ошибка');
        } catch { alert('Сетевая ошибка'); }
    }

    // ===== Редактирование события =====

    function openEditEventModal(ev) {
        const modal = document.getElementById('editEventModal');
        if (!modal) return;

        document.getElementById('editEventId').value = String(ev.id);
        document.getElementById('editEventOriginalStartUtc').value = ev.startUtc;
        document.getElementById('editEventPresetId').value = String(ev.presetId || 0);
        const cover = presetCovers[ev.presetId] || '';
        const coverImg = document.getElementById('editEventCover');
        if (coverImg) {
            if (cover) { coverImg.src = cover; coverImg.style.display = 'block'; }
            else { coverImg.removeAttribute('src'); coverImg.style.display = 'none'; }
        }
        document.getElementById('editEventTitle').value = ev.title;
        document.getElementById('editEventDescription').value = ev.description;
        document.getElementById('editEventStart').value = utcToLocalInput(ev.startUtc);
        document.getElementById('editEventEnd').value = utcToLocalInput(ev.endUtc);

        const loc = ev.location || '';

        const editSeriesBtn = document.getElementById('editEventEditSeriesBtn');
        const makeSeriesBtn = document.getElementById('editEventMakeSeriesBtn');
        const cancelAllBtn = document.getElementById('editEventCancelAllBtn');
        if (editSeriesBtn) editSeriesBtn.style.display = 'none';
        if (makeSeriesBtn) makeSeriesBtn.style.display = 'none';
        if (cancelAllBtn) cancelAllBtn.style.display = 'none';

        const titleInput = document.getElementById('editEventTitle');
        const descInput = document.getElementById('editEventDescription');
        const locSelect = document.getElementById('editEventLocationSelect');
        const locText = document.getElementById('editEventLocationText');
        [titleInput, descInput, locText].forEach(el => { if (el) { el.disabled = false; el.readOnly = false; } });
        if (locSelect) locSelect.disabled = false;

        // Как в настройке пресета: выбран голосовой канал — текстовое поле скрыто,
        // канал не выбран — поле доступно для произвольного текста.
        const isChannel = voiceChannels.some(c => c.id === loc);
        if (isChannel) {
            if (locSelect) locSelect.value = loc;
            if (locText) { locText.value = ''; locText.style.display = 'none'; }
        } else {
            if (locSelect) locSelect.value = '';
            if (locText) { locText.value = loc; locText.style.display = 'block'; }
        }

        const locked = ev.isSeriesPreset || ev.isRecurring;
        const infoPanel = document.getElementById('editEventInfoPanel');
        const editableFields = document.getElementById('editEventEditableFields');
        const locationGroup = document.getElementById('editEventLocationGroup');

        if (locked) {
            // Карточка серии — конкретное вхождение: правим только дату и время.
            const locationText = voiceChannels.find(c => c.id === loc)?.name || loc || '—';
            let html = `<div class="info-title">${escapeHtml(ev.title || '')}</div>`;
            if (ev.description) html += `<div class="info-row">${escapeHtml(ev.description)}</div>`;
            html += `<div class="info-row">Локация: ${escapeHtml(locationText)}</div>`;
            if (infoPanel) { infoPanel.innerHTML = html; infoPanel.style.display = 'block'; }
            if (editableFields) editableFields.style.display = 'none';
            if (locationGroup) locationGroup.style.display = 'none';
            if (ev.isSeriesPreset && editSeriesBtn) editSeriesBtn.style.display = 'inline-block';
            if (ev.hasPreset && !ev.isRecurring && makeSeriesBtn) makeSeriesBtn.style.display = 'inline-block';
            if (cancelAllBtn) cancelAllBtn.style.display = 'inline-block';
        } else {
            if (infoPanel) infoPanel.style.display = 'none';
            if (editableFields) editableFields.style.display = 'block';
            if (locationGroup) locationGroup.style.display = 'block';
        }

        document.getElementById('editEventError').style.display = 'none';
        modal.classList.add('is-open');
    }

    function closeEditEventModal() {
        document.getElementById('editEventModal')?.classList.remove('is-open');
    }

    async function updateEvent() {
        const id = parseInt(document.getElementById('editEventId').value) || 0;
        const title = document.getElementById('editEventTitle').value.trim();
        const description = document.getElementById('editEventDescription').value;
        const startLocal = document.getElementById('editEventStart').value;
        const endLocal = document.getElementById('editEventEnd').value;
        let evLocation = document.getElementById('editEventLocationSelect').value;
        if (!evLocation && document.getElementById('editEventLocationText').value.trim())
            evLocation = document.getElementById('editEventLocationText').value.trim();

        // Галочки «повторяющееся» в карточке больше нет: повторения задаются пресетом.
        // Пустое значение => бэкенд не меняет IsRecurring.
        const isRecurring = '';
        const recFreq = '';

        const err = document.getElementById('editEventError');
        const btn = document.getElementById('editEventSaveBtn');
        err.style.display = 'none';
        if (!title) { err.textContent = 'Название обязательно'; err.style.display = 'block'; return; }
        if (!startLocal || !endLocal) { err.textContent = 'Укажите начало и окончание'; err.style.display = 'block'; return; }
        if (new Date(endLocal) <= new Date(startLocal)) {
            err.textContent = 'Окончание должно быть позже начала'; err.style.display = 'block'; return;
        }

        btn.disabled = true; btn.textContent = 'Сохраняю...';
        try {
            const r = await fetch('/Calendar/UpdateEvent', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({
                    id, title, description,
                    location: evLocation,
                    startUtc: new Date(startLocal).toISOString(),
                    endUtc: new Date(endLocal).toISOString(),
                    isRecurring: isRecurring,
                    recurrenceFrequency: recFreq,
                    recurrenceByWeekdays: '',
                    originalStartUtc: document.getElementById('editEventOriginalStartUtc').value || ''
                })
            });
            const data = await r.json();
            if (data.success) window.location.reload();
            else { err.textContent = data.error || 'Ошибка'; err.style.display = 'block'; }
        } catch { err.textContent = 'Сетевая ошибка'; err.style.display = 'block'; }
        finally { btn.disabled = false; btn.textContent = 'Сохранить'; }
    }

    async function deleteEvent() {
        const id = parseInt(document.getElementById('editEventId').value) || 0;
        if (!id) return;
        if (!confirm('Убрать карточку с сетки? В Discord событие останется, пока не удалён его пресет.')) return;
        // Берём ИСХОДНУЮ дату карточки из скрытого поля, а не из (возможно изменённого) поля ввода.
        const startUtc = document.getElementById('editEventOriginalStartUtc').value;
        try {
            const r = await fetch('/Calendar/DeleteEvent', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({
                    id,
                    originalStartUtc: startUtc ? new Date(startUtc).toISOString() : ''
                })
            });
            const data = await r.json();
            if (data.success) window.location.reload();
            else alert(data.error || 'Ошибка');
        } catch { alert('Сетевая ошибка'); }
    }

    async function cancelAllOccurrences() {
        const id = parseInt(document.getElementById('editEventId').value) || 0;
        if (!id) return;
        if (!confirm('Отменить все будущие повторения? Карточки исчезнут с сетки, а в Discord будут пропущены.')) return;
        try {
            const r = await fetch('/Calendar/CancelAllOccurrences', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ eventId: id })
            });
            const data = await r.json();
            if (data.success) window.location.reload();
            else alert(data.error || 'Ошибка');
        } catch { alert('Сетевая ошибка'); }
    }

