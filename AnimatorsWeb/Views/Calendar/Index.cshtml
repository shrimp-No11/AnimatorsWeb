    async function deletePattern(id, name) {
        if (!confirm(`Удалить паттерн «${name}»? Все его размещения на календаре и связанные будущие события тоже будут удалены.`)) return;
        try {
            const r = await fetch('/Calendar/DeletePattern', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({ id })
            });
            const data = await r.json();
            if (data.success) window.location.reload();
            else alert(data.error || 'Ошибка');
        } catch { alert('Сетевая ошибка'); }
    }

    // ===== Клик по ячейке =====
    document.querySelectorAll('.cal-cell').forEach(cell => {
        cell.addEventListener('click', e => {
            if (e.target.closest('.cal-event-bar')) return;
            if (!isModerator) return;
            openCreateEventModal(cell.dataset.date, null);
        });
    });

    // ===== Drag&drop =====
    if (isModerator) {
        document.querySelectorAll('.cal-preset-item[data-preset-id]').forEach(el => {
            el.addEventListener('dragstart', e => {
                e.dataTransfer.setData('application/x-preset-id', el.dataset.presetId);
                e.dataTransfer.effectAllowed = 'copy';
            });
        });
        document.querySelectorAll('.cal-preset-item[data-pattern-id]').forEach(el => {
            el.addEventListener('dragstart', e => {
                e.dataTransfer.setData('application/x-pattern-id', el.dataset.patternId);
                e.dataTransfer.effectAllowed = 'copy';
            });
        });

        document.querySelectorAll('.cal-cell').forEach(cell => {
            cell.addEventListener('dragover', e => {
                const hasP = e.dataTransfer.types.includes('application/x-preset-id');
                const hasPat = e.dataTransfer.types.includes('application/x-pattern-id');
                const hasEv = e.dataTransfer.types.includes('application/x-event-id');
                if (!hasP && !hasPat && !hasEv) return;
                e.preventDefault();
                e.dataTransfer.dropEffect = hasEv ? 'move' : 'copy';
                cell.style.background = 'color-mix(in srgb, var(--brand-primary) 12%, var(--brand-card))';
            });
            cell.addEventListener('dragleave', () => { cell.style.background = ''; });
            cell.addEventListener('drop', async e => {
                e.preventDefault();
                cell.style.background = '';
                const dateMsk = cell.dataset.date;
                if (!dateMsk) return;

                const eventIdStr = e.dataTransfer.getData('application/x-event-id');
                if (eventIdStr) {
                    const eventId = parseInt(eventIdStr);
                    const evStartUtc = e.dataTransfer.getData('application/x-event-start');
                    if (!eventId || !evStartUtc) return;

                    const d = new Date(evStartUtc);
                    const oldLocalDate = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
                    if (oldLocalDate === dateMsk) return;

                    const oldD = new Date(oldLocalDate + 'T00:00:00');
                    const newD = new Date(dateMsk + 'T00:00:00');
                    const daysDelta = Math.round((newD - oldD) / (1000 * 60 * 60 * 24));
                    if (daysDelta === 0) return;

                    const sign = daysDelta > 0 ? '+' : '';

                    try {
                        const r = await fetch('/Calendar/MoveEvent', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: new URLSearchParams({
                                eventId,
                                daysDelta,
                                originalStartUtc: new Date(evStartUtc).toISOString()
                            })
                        });
                        const data = await r.json();
                        if (data.success) window.location.reload();
                        else alert(data.error || 'Ошибка');
                    } catch { alert('Сетевая ошибка'); }
                    return;
                }

                const presetIdStr = e.dataTransfer.getData('application/x-preset-id');
                if (presetIdStr) {
                    const presetId = parseInt(presetIdStr);
                    if (presetId) await createEventFromPresetDirect(presetId, dateMsk);
                    return;
                }
                const patternIdStr = e.dataTransfer.getData('application/x-pattern-id');
                if (patternIdStr) {
                    const patternId = parseInt(patternIdStr);
                    if (!patternId) return;
                    if (!confirm('Разместить паттерн начиная с этой даты?')) return;
                    try {
                        const r = await fetch('/Calendar/PlacePattern', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: new URLSearchParams({ patternId, dateMsk })
                        });
                        const data = await r.json();
                        if (data.success) window.location.reload();
                        else alert(data.error || 'Ошибка');
                    } catch { alert('Сетевая ошибка'); }
                }
            });
        });
    }
    function onEditEventRecurringChange() {
        const cb = document.getElementById('editEventIsRecurring');
        const f = document.getElementById('editEventRecurringFields');
        if (cb && f) f.style.display = cb.checked ? 'block' : 'none';
    }
    // ===== Apply =====
    async function refreshFromDiscord() {
        const btn = document.getElementById('refreshDiscordBtn');
        if (document.getElementById('pendingApplyHint')
            && !confirm('Взять фактическое состояние из Discord? Неприменённые изменения на сайте будут потеряны.')) {
            return;
        }
        if (btn) { btn.disabled = true; btn.textContent = 'Загружаю из Discord…'; }
        try {
            const r = await fetch('/Calendar/PullFromDiscord', { method: 'POST' });
            const data = await r.json();
            if (data.success) window.location.reload();
            else alert(data.error || 'Ошибка обновления');
        } catch { alert('Сетевая ошибка: сервер не ответил. Обновите страницу — синхронизация могла продолжиться.'); }
        finally { if (btn) { btn.disabled = false; btn.textContent = '⬇ Получить ивенты'; } }
    }

    async function previewApply() {
        const modal = document.getElementById('applyModal');
        if (!modal) return;
        document.getElementById('applyLoading').style.display = 'block';
        document.getElementById('applyResult').style.display = 'none';
        modal.classList.add('is-open');
        try {
            const r = await fetch('/Calendar/ApplyToDiscordPreview');
            const data = await r.json();
            document.getElementById('applyLoading').style.display = 'none';
            document.getElementById('applyResult').style.display = 'block';
            if (data.success === false) {
                document.getElementById('applyItemsList').innerHTML =
                    `<p style="color: var(--brand-accent);">${escapeHtml(data.error || 'Ошибка подготовки')}</p>`;
                document.getElementById('applyConfirmBtn').disabled = true;
                return;
            }
            document.getElementById('applyCreateCount').textContent = data.toCreate;
            document.getElementById('applyUpdateCount').textContent = data.toUpdate;
            document.getElementById('applyDeleteCount').textContent = data.toDelete;
            const list = document.getElementById('applyItemsList');
            if (data.items.length === 0) {
                list.innerHTML = '<p style="color: var(--cal-muted);">Изменений нет.</p>';
            } else {
                list.innerHTML = data.items.map(i => {
                    const d = new Date(i.startUtc);
                    const dateStr = d.toLocaleString('ru-RU');
                    const color = i.action === 'update' ? 'var(--brand-accent)' : 'var(--brand-primary)';
                    const label = i.action === 'create' ? '+ создать' : i.action === 'update' ? '~ обновить' : '− удалить';
                    return `<div style="padding: 4px 0; border-bottom: 1px solid var(--cal-line);">
                        <span style="color: ${color}; font-weight: 700;">${label}</span>
                        ${escapeHtml(i.title)} <span style="color: var(--cal-muted);">— ${dateStr}</span>
                    </div>`;
                }).join('');
            }
            document.getElementById('applyConfirmBtn').disabled =
                data.toCreate === 0 && data.toUpdate === 0 && data.toDelete === 0;
        } catch {
            document.getElementById('applyLoading').textContent =
                'Сервер не ответил. Закройте окно и попробуйте ещё раз.';
        }
    }
    function closeApplyModal() { document.getElementById('applyModal')?.classList.remove('is-open'); }
    async function doApply() {
        const btn = document.getElementById('applyConfirmBtn');
        btn.disabled = true; btn.textContent = 'Отправляю…';
        try {
            const r = await fetch('/Calendar/ApplyToDiscord', { method: 'POST' });
            const data = await r.json();
            if (data.success) {
                closeApplyModal();
                const errors = Array.isArray(data.errors) ? data.errors : [];
                if (errors.length) {
                    alert('Синхронизация завершена, но не всё доехало до Discord:\n\n' + errors.join('\n'));
                }
                window.location.reload();
            }
            else {
                alert(data.error || 'Ошибка применения');
                btn.disabled = false;
                btn.textContent = '⬆ Отправить в Discord';
            }
        } catch {
            alert('Сетевая ошибка: сервер не ответил. Обновите страницу — синхронизация могла продолжиться.');
            btn.disabled = false;
            btn.textContent = '⬆ Отправить в Discord';
        }
    }

    const presetCovers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Presets.ToDictionary(p => p.Id, p =>
                p.CoverImageUrl ?? (p.CoverImageFileName != null ? "/uploads/covers/" + p.CoverImageFileName : ""))
        ));
    const presetColors = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Presets.ToDictionary(p => p.Id, p =>
                new[] { "primary", "accent", "hover", "text", "bg" }.Contains(p.Color ?? "")
                    ? p.Color! : "primary")
    ));
    const seriesPresetIds = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Presets.Where(p => p.IsDiscordSeries && !p.IsDeleted).Select(p => p.Id).ToList()
    ));

    // ===== Рендер событий горизонтальными полосами =====
        (function renderCalendarEvents() {
        const events = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        Model.AllGridEvents.Select(e => new
                        {
                                id = e.Id,
                                title = e.Title ?? "",
                                description = e.Description ?? "",
                                location = e.Location ?? "",
                                startUtc = e.StartUtc.ToString("yyyy-MM-ddTHH:mm:ssZ"),
                                endUtc = e.EndUtc.ToString("yyyy-MM-ddTHH:mm:ssZ"),
                                isRecurring = e.IsRecurring,
                                recurrenceRuleJson = e.RecurrenceRuleJson ?? "",
                                hasPreset = e.EventPresetId.HasValue,
                                presetId = e.EventPresetId ?? 0,
                                syncToDiscord = !e.SkipDiscordSync
                        })
                ));
        if (!events.length) return;

        const weeks = document.querySelectorAll('.cal-week');
        if (!weeks.length) return;

        const dateToIdx = {};
        weeks.forEach((week, weekIndex) => {
            week.querySelectorAll('.cal-cell').forEach(cell => {
                dateToIdx[cell.dataset.date] = weekIndex * 7 + parseInt(cell.style.gridColumn) - 1;
            });
        });

        function localDateStr(date) {
            return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
        }
        function fmtTime(utcStr) {
            const d = new Date(utcStr);
            if (isNaN(d)) return '';
            return d.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
        }

        const weekEvents = Array.from({ length: weeks.length }, () => []);

        events.forEach(ev => {
            const startLocal = new Date(ev.startUtc);
            const endLocal = new Date(ev.endUtc);
            if (isNaN(startLocal) || isNaN(endLocal) || endLocal <= startLocal) return;

            const startDate = localDateStr(startLocal);
            const endDate = localDateStr(new Date(endLocal.getTime() - 1000));

            let startIdx = dateToIdx[startDate];
            let endIdx = dateToIdx[endDate];
            if (startIdx === undefined && endIdx === undefined) return;
            if (startIdx === undefined) startIdx = 0;
            if (endIdx === undefined) endIdx = weeks.length * 7 - 1;
            if (startIdx > endIdx) return;

            let cur = startIdx;
            while (cur <= endIdx) {
                const weekStart = Math.floor(cur / 7) * 7;
                const weekEnd = weekStart + 6;
                const segEnd = Math.min(endIdx, weekEnd);
                const weekIndex = Math.floor(cur / 7);
                weekEvents[weekIndex].push({
                    event: ev,
                    colStart: cur - weekStart,
                    colEnd: segEnd - weekStart,
                    isStart: cur === startIdx,
                    isEnd: segEnd === endIdx
                });
                cur = weekEnd + 1;
            }
        });

        weekEvents.forEach((items, weekIndex) => {
            if (!items.length) return;
            items.sort((a, b) => {
                const la = a.colEnd - a.colStart, lb = b.colEnd - b.colStart;
                if (la !== lb) return lb - la;
                return a.colStart - b.colStart;
            });
            const lanes = [];
            items.forEach(item => {
                let lane = 0;
                while (true) {
                    if (!lanes[lane]) lanes[lane] = [];
                    const conflict = lanes[lane].some(x =>
                        !(item.colEnd < x.colStart || item.colStart > x.colEnd)
                    );
                    if (!conflict) {
                        lanes[lane].push({ colStart: item.colStart, colEnd: item.colEnd });
                        item.lane = lane;
                        break;
                    }
                    lane++;
                }
            });
            const maxLane = Math.max(...items.map(i => i.lane));
            const weekEl = weeks[weekIndex];
            const dayEventCounts = new Array(7).fill(0);
            items.forEach(it => {
                for (let c = it.colStart; c <= it.colEnd; c++) dayEventCounts[c]++;
            });
            weekEl.style.gridTemplateRows = `24px repeat(${maxLane + 1}, minmax(0, 1fr))`;

            items.forEach(item => {
                const ev = item.event;
                const bar = document.createElement('div');
                bar.className = 'cal-event-bar';
                const color = presetColors[ev.presetId] || 'primary';
                bar.classList.add(`color-${color}`);
                if (!ev.syncToDiscord) bar.classList.add('local');

                bar.style.gridColumn = `${item.colStart + 1} / span ${item.colEnd - item.colStart + 1}`;
                let allSingle = true;
                for (let c = item.colStart; c <= item.colEnd; c++) {
                    if (dayEventCounts[c] > 1) { allSingle = false; break; }
                }
                if (allSingle) {
                    bar.style.gridRow = '2 / -1';
                } else {
                    bar.style.gridRow = String(item.lane + 2);
                }

                const time = fmtTime(ev.startUtc);
                const timeText = item.isStart ? time : '←';
                const titleText = escapeHtml(ev.title || '') + (!item.isEnd ? ' →' : '');
                bar.innerHTML = `<div class="cal-event-time">${timeText}</div><div class="cal-event-title">${titleText}</div>`;
                bar.title = ev.title || '';

                // Любая карточка на сетке переносится. Для повторяющегося события сервер
                // отменит исходное вхождение и создаст новую карточку на новой дате.
                if (isModerator) {
                    bar.draggable = true;
                    bar.addEventListener('dragstart', e => {
                        e.stopPropagation();
                        e.dataTransfer.setData('application/x-event-id', String(ev.id));
                        e.dataTransfer.setData('application/x-event-start', ev.startUtc);
                        e.dataTransfer.effectAllowed = 'move';
                    });
                }

                bar.addEventListener('click', e => {
                    e.stopPropagation();
                    if (!isModerator) return;
                    openEditEventModal({
                        id: ev.id,
                        title: ev.title || '',
                        description: ev.description || '',
                        location: ev.location || '',
                        startUtc: ev.startUtc,
                        endUtc: ev.endUtc,
                        isRecurring: ev.isRecurring,
                        recurrenceRuleJson: ev.recurrenceRuleJson,
                        hasPreset: ev.hasPreset,
                        presetId: ev.presetId,
                        isSeriesPreset: seriesPresetIds.includes(ev.presetId)
                    });
                });

                weekEl.appendChild(bar);
            });
        });
    })();

    // Авто-обновление открытой страницы. Сервер меняет версию, когда календарь
    // обновился (gateway Discord, Pull, Apply или правка в другой вкладке).
    // Опрашивается только маленький in-memory счётчик: Discord и БД не трогаем.
    let calendarVersion = @AnimatorsWeb.Services.CalendarChangeNotifier.Version;
    let calendarVersionCheckRunning = false;

    async function checkCalendarVersion() {
        if (calendarVersionCheckRunning) return;
        if (document.hidden || calRequestsInFlight > 0) return;
        if (document.querySelector('.cal-modal.is-open')) return;

        calendarVersionCheckRunning = true;
        try {
            const r = await fetch('/Calendar/SyncVersion', {
                cache: 'no-store',
                headers: { 'Accept': 'application/json' }
            });
            if (!r.ok) return;
            const data = await r.json();
            if (data.version !== calendarVersion
                && calRequestsInFlight === 0
                && !document.querySelector('.cal-modal.is-open')) {
                // Защита от цикла, если вкладка попала на другой инстанс приложения.
                const lastReload = Number(sessionStorage.getItem('calendar:autoReloadAt') || 0);
                if (Date.now() - lastReload > 15000) {
                    sessionStorage.setItem('calendar:autoReloadAt', String(Date.now()));
                    window.location.reload();
                }
            }
        } catch { /* сеть недоступна — попробуем при следующей проверке */ }
        finally { calendarVersionCheckRunning = false; }
    }

    setInterval(checkCalendarVersion, 30000);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) checkCalendarVersion(); });
    window.addEventListener('focus', checkCalendarVersion);
</script>