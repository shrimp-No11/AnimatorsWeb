            <label>Время начала</label>
            <input type="time" id="createEventTime" value="20:00" />

            <div class="cal-modal-actions">
                <button type="button" class="cancel" onclick="closeCreateEventModal()">Отмена</button>
                <button type="button" class="save" onclick="createEvent()" id="createEventBtn">Создать</button>
            </div>
        </div>
    </div>

    <div id="editEventModal" class="cal-modal">
        <div class="cal-modal-content">
            <h3>Редактировать событие</h3>
            <div id="editEventError" class="cal-error"></div>
            <img id="editEventCover" alt="Обложка" style="display:none; max-width:100%; max-height:140px; border-radius:8px; margin-bottom:12px;" />
            <input type="hidden" id="editEventId" />
            <input type="hidden" id="editEventOriginalStartUtc" />
            <input type="hidden" id="editEventPresetId" />

            <div id="editEventInfoPanel" class="cal-info-panel" style="display:none;"></div>

            <div id="editEventEditableFields">
                <label>Название</label>
                <input type="text" id="editEventTitle" />
                <label>Описание</label>
