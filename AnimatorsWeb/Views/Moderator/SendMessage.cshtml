@model AnimatorsWeb.Models.ChannelSelectViewModel
@{
    ViewData["Title"] = "Отправить сообщение";
}

<style>
    .sm-file-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 10px;
        margin-top: 10px;
    }

    .sm-file-card {
        position: relative;
        border: 1px solid #ddd;
        border-radius: 8px;
        background: #fafafa;
        padding: 8px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-size: 12px;
    }

    .sm-file-thumb {
        width: 100%;
        aspect-ratio: 16/10;
        background: #1a1a1a;
        border-radius: 6px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .sm-file-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .sm-file-thumb .icon {
            color: #999;
            font-size: 32px;
        }

    .sm-file-name {
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .sm-file-size {
        color: #888;
    }

    .sm-file-remove {
        position: absolute;
        top: 4px;
        right: 4px;
        width: 24px;
        height: 24px;
        border: none;
        border-radius: 50%;
        background: rgba(0,0,0,0.6);
        color: white;
        cursor: pointer;
        font-size: 14px;
        line-height: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .sm-file-remove:hover {
            background: #b3261e;
        }

    .sm-progress-wrap {
        display: none;
        margin: 15px 0;
        background: #eee;
        border-radius: 999px;
        overflow: hidden;
        height: 10px;
    }

    .sm-progress-bar {
        height: 100%;
        width: 0;
        background: var(--brand-primary);
        transition: width 0.15s;
    }

    .sm-status {
        display: none;
        margin: 10px 0;
        padding: 10px 14px;
        border-radius: 8px;
        font-weight: 500;
    }

        .sm-status.ok {
            background: #e7f7ec;
            color: #1a7f37;
        }

        .sm-status.err {
            background: #fdecea;
            color: #b3261e;
        }
</style>

<h1>Отправить сообщение в Discord</h1>

<div id="statusBox" class="sm-status"></div>

<form id="sendForm" method="post" enctype="multipart/form-data"
      asp-controller="Moderator" asp-action="SendAnnouncement">

    <div class="form-group">
        <label asp-for="SelectedChannelId">Канал для публикации:</label>
        <select asp-for="SelectedChannelId"
                asp-items="Model.ChannelList"
                class="form-control">
            <option value="">-- Выберите канал --</option>
        </select>
    </div>

    <div class="form-group">
        <label for="text">Текст сообщения:</label>
        <textarea name="text" id="text" rows="6" class="form-control"
                  placeholder="Введите текст сообщения..."></textarea>
    </div>

    <div class="form-group">
        <label>Файлы:</label>
        <input type="file" id="fileInput" multiple style="display: none;" />
        <button type="button" id="addFilesBtn" class="btn btn-secondary">
            📎 Добавить файлы
        </button>
        <small style="color: gray; display: block; margin-top: 4px;">
            До @ViewBag.MaxFileSizeMb МБ на файл.        
        </small>
        <div id="fileList" class="sm-file-list"></div>
    </div>

    <div id="progressWrap" class="sm-progress-wrap">
        <div id="progressBar" class="sm-progress-bar"></div>
    </div>

    <button type="submit" id="submitBtn" class="btn btn-primary">Отправить</button>
</form>

<script>
    (function () {
        const form = document.getElementById('sendForm');
        const fileInput = document.getElementById('fileInput');
        const addFilesBtn = document.getElementById('addFilesBtn');
        const fileList = document.getElementById('fileList');
        const progressWrap = document.getElementById('progressWrap');
        const progressBar = document.getElementById('progressBar');
        const submitBtn = document.getElementById('submitBtn');
        const statusBox = document.getElementById('statusBox');

        // Выбранные файлы — в JS-массиве, чтобы можно было удалять по одному
        let selectedFiles = [];

        function showStatus(text, ok) {
            statusBox.textContent = text;
            statusBox.className = 'sm-status ' + (ok ? 'ok' : 'err');
            statusBox.style.display = 'block';
            if (ok) setTimeout(() => { statusBox.style.display = 'none'; }, 4000);
        }

        function formatSize(bytes) {
            if (bytes < 1024) return bytes + ' Б';
            if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' КБ';
            return (bytes / (1024 * 1024)).toFixed(1) + ' МБ';
        }

        function isImage(file) {
            return file.type.startsWith('image/');
        }

        function renderFiles() {
            fileList.innerHTML = '';

            selectedFiles.forEach((file, index) => {
                const card = document.createElement('div');
                card.className = 'sm-file-card';

                const thumb = document.createElement('div');
                thumb.className = 'sm-file-thumb';
                if (isImage(file)) {
                    const img = document.createElement('img');
                    img.src = URL.createObjectURL(file);
                    img.onload = () => URL.revokeObjectURL(img.src);
                    thumb.appendChild(img);
                } else {
                    const icon = document.createElement('div');
                    icon.className = 'icon';
                    icon.textContent = file.type.startsWith('video/') ? '🎬' : '📄';
                    thumb.appendChild(icon);
                }

                const name = document.createElement('div');
                name.className = 'sm-file-name';
                name.textContent = file.name;
                name.title = file.name;

                const size = document.createElement('div');
                size.className = 'sm-file-size';
                size.textContent = formatSize(file.size);

                const remove = document.createElement('button');
                remove.type = 'button';
                remove.className = 'sm-file-remove';
                remove.innerHTML = '×';
                remove.title = 'Убрать';
                remove.onclick = () => {
                    selectedFiles.splice(index, 1);
                    renderFiles();
                };

                card.appendChild(thumb);
                card.appendChild(name);
                card.appendChild(size);
                card.appendChild(remove);
                fileList.appendChild(card);
            });
        }

        addFilesBtn.addEventListener('click', () => fileInput.click());

        fileInput.addEventListener('change', (e) => {
            const maxSize = @ViewBag.MaxFileSizeBytes;
            let rejected = 0;

            for (const f of e.target.files) {
                if (f.size > maxSize) { rejected++; continue; }
                // не добавляем дубликаты (имя + размер)
                const exists = selectedFiles.some(
                    s => s.name === f.name && s.size === f.size);
                if (exists) continue;
                selectedFiles.push(f);
            }

            fileInput.value = ''; // сбрасываем, чтобы можно было выбрать тот же файл снова
            renderFiles();

            if (rejected > 0) {
                    const maxMb = Math.floor(@ViewBag.MaxFileSizeBytes / 1_000_000);
                    showStatus(`Пропущено файлов больше ${maxMb} МБ: ${rejected}`, false);
            }
        });

        form.addEventListener('submit', (e) => {
            e.preventDefault();

            const channelId = form.querySelector('select[name="SelectedChannelId"]').value;
            const text = form.querySelector('textarea[name="text"]').value.trim();

            if (!channelId) { showStatus('Выберите канал.', false); return; }
            if (!text && selectedFiles.length === 0) {
                showStatus('Нечего отправлять — ни текста, ни файлов.', false);
                return;
            }

            const formData = new FormData();
            formData.append('selectedChannelId', channelId);
            formData.append('text', text);
            selectedFiles.forEach(f => formData.append('files', f, f.name));

            submitBtn.disabled = true;
            addFilesBtn.disabled = true;
            progressWrap.style.display = 'block';
            progressBar.style.width = '0%';
            statusBox.style.display = 'none';

            const xhr = new XMLHttpRequest();
            xhr.open('POST', form.action, true);
            xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');

            xhr.upload.onprogress = (e) => {
                if (e.lengthComputable) {
                    const pct = Math.round((e.loaded / e.total) * 100);
                    progressBar.style.width = pct + '%';
                }
            };

            xhr.onload = () => {
                submitBtn.disabled = false;
                addFilesBtn.disabled = false;

                try {
                    const resp = JSON.parse(xhr.responseText);
                    if (resp.success) {
                        progressBar.style.width = '100%';
                        setTimeout(() => { progressWrap.style.display = 'none'; }, 400);
                        showStatus(resp.message || 'Отправлено!', true);
                        // очищаем форму после успеха
                        form.querySelector('textarea[name="text"]').value = '';
                        selectedFiles = [];
                        renderFiles();
                    } else {
                        progressWrap.style.display = 'none';
                        showStatus(resp.error || 'Ошибка отправки', false);
                    }
                } catch {
                    progressWrap.style.display = 'none';
                    showStatus('Неожиданный ответ сервера', false);
                }
            };

            xhr.onerror = () => {
                submitBtn.disabled = false;
                addFilesBtn.disabled = false;
                progressWrap.style.display = 'none';
                showStatus('Сетевая ошибка при отправке', false);
            };

            xhr.send(formData);
        });
    })();
</script>