@model AnimatorsWeb.Models.ChannelSelectViewModel

@{
    ViewData["Title"] = "Выбор темы";
}

<h1>Голосование за тему аниджема</h1>

@if (ViewBag.Error != null)
{
    <p style="color: red;">@ViewBag.Error</p>
}
@if (ViewBag.Result != null)
{
    <p style="color: green;">@ViewBag.Result</p>
}

<form asp-action="PublishThemePoll" method="post">
    <div class="form-group">
        <label>Номер аниджема:</label>
        <input type="number" name="animJamNumber" value="@ViewBag.NextNumber" required />
    </div>

    <div class="form-group">
        <label asp-for="SelectedChannelId">Канал для публикации:</label>
        <select asp-for="SelectedChannelId"
                asp-items="Model.ChannelList"
                class="form-control">
            <option value="">-- Выберите канал --</option>
        </select>
    </div>

    <p>Введите темы (от 2 до 10):</p>

    <div id="themes-container">
        @for (int i = 1; i <= 4; i++)
        {
            <div class="form-group theme-row" style="display: flex; gap: 10px; align-items: center;">
                <input type="text" name="themes" placeholder="@($"Тема {i}")" class="form-control" style="flex: 1;" />
                <button type="button" onclick="removeTheme(this)">Удалить</button>
            </div>
        }
    </div>

    <button type="button" onclick="addTheme()">+ Добавить тему</button>
    <br /><br />

    <button type="submit" class="btn btn-primary">Опубликовать голосование</button>
</form>

<script>
    const container = document.getElementById('themes-container');
    const MAX = 10;
    const MIN = 2;

    function addTheme() {
        const rows = document.querySelectorAll('.theme-row');
        if (rows.length >= MAX) {
            alert('Максимум 10 тем');
            return;
        }

        const row = document.createElement('div');
        row.className = 'form-group theme-row';
        row.style.cssText = 'display: flex; gap: 10px; align-items: center;';
        row.innerHTML = `
                <input type="text" name="themes" class="form-control" style="flex: 1;" />
                <button type="button" onclick="removeTheme(this)">Удалить</button>
            `;
        container.appendChild(row);
        renumberPlaceholders();
    }

    function removeTheme(btn) {
        const rows = document.querySelectorAll('.theme-row');
        if (rows.length <= MIN) {
            alert('Должно быть минимум 2 темы');
            return;
        }
        btn.parentElement.remove();
        renumberPlaceholders();
    }

    function renumberPlaceholders() {
        const inputs = document.querySelectorAll('.theme-row input');
        inputs.forEach((input, i) => {
            input.placeholder = `Тема ${i + 1}`;
        });
    }
</script>