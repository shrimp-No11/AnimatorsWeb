@model AnimatorsWeb.Models.ChannelSettingsViewModel

@{
    ViewData["Title"] = "Модераторская";
    int pendingLinks = ViewBag.PendingLinksCount is int c ? c : 0;
}

<style>
    .mod-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 18px;
        margin-bottom: 30px;
    }

    .mod-card {
        background: var(--brand-card);
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 14px;
        padding: 18px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        transition: box-shadow 0.15s, transform 0.15s;
    }
    .mod-card:hover {
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
        transform: translateY(-2px);
    }

    .mod-card-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    }
    .mod-card-icon {
        font-size: 24px;
        line-height: 1;
    }
    .mod-card-title {
        margin: 0;
        font-size: 17px;
        font-weight: 700;
    }

    .mod-card .mod-link {
        display: block;
        padding: 10px 14px;
        margin-bottom: 8px;
        background: var(--brand-primary);
        color: white !important;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 500;
        font-size: 14px;
        transition: background 0.15s;
        position: relative;
    }
    .mod-card .mod-link:last-child {
        margin-bottom: 0;
    }
    .mod-card .mod-link:hover {
        background: var(--brand-primary-hover);
    }

    .mod-card .mod-link.attention {
        background: #e67e22;
    }
    .mod-card .mod-link.attention:hover {
        background: #c96e19;
    }

    .mod-badge {
        position: absolute;
        top: -8px;
        right: -8px;
        background: #e74c3c;
        color: white;
        border-radius: 10px;
        padding: 2px 8px;
        font-size: 12px;
        font-weight: bold;
        border: 2px solid white;
        line-height: 1.3;
    }

    .mod-settings {
        background: var(--brand-card);
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 14px;
        padding: 0;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        margin-top: 10px;
    }
    .mod-settings summary {
        cursor: pointer;
        font-size: 16px;
        font-weight: 700;
        padding: 16px 18px;
        list-style: none;
        display: flex;
        align-items: center;
        gap: 10px;
        user-select: none;
    }
    .mod-settings summary::-webkit-details-marker {
        display: none;
    }
    .mod-settings summary::after {
        content: "▸";
        margin-left: auto;
        transition: transform 0.2s;
        color: #888;
    }
    .mod-settings[open] summary::after {
        transform: rotate(90deg);
    }
    .mod-settings[open] summary {
        border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    }
    .mod-settings .settings-body {
        padding: 18px;
    }
</style>

<h1>Модераторская панель</h1>

@if (TempData["Result"] != null)
{
    <div style="background: #e7f7ec; color: #1a7f37; padding: 10px 16px; border-radius: 8px; margin-bottom: 16px;">
        @TempData["Result"]
    </div>
}

<hr />

<h2 style="margin-bottom: 18px;">Действия</h2>

<div class="mod-grid">

    <div class="mod-card">
        <div class="mod-card-header">
            <span class="mod-card-icon">🎬</span>
            <h3 class="mod-card-title">Создание аниджема</h3>
        </div>
        <a asp-action="ChooseTheme" class="mod-link">Голосование за тему</a>
        <a asp-action="CreateAnimJam" class="mod-link">Старт аниджема</a>
    </div>

    <div class="mod-card">
        <div class="mod-card-header">
            <span class="mod-card-icon">🏆</span>
            <h3 class="mod-card-title">Подведение итогов</h3>
        </div>
        <a asp-action="CreateWinnerPoll" class="mod-link">Голосование за победителей</a>
        <a asp-action="AnnounceWinners" class="mod-link">Объявить победителей</a>
    </div>

    <div class="mod-card">
        <div class="mod-card-header">
            <span class="mod-card-icon">💬</span>
            <h3 class="mod-card-title">Сообщество</h3>
        </div>
        <a asp-action="SendMessage" class="mod-link">Отправить сообщение</a>
        <a asp-action="Rules" class="mod-link">Правила</a>
        @if (pendingLinks > 0)
        {
            <a asp-action="LinkedAccounts" class="mod-link attention">
                🔗 Связи аккаунтов
                <span class="mod-badge">@pendingLinks</span>
            </a>
        }
        else
        {
            <a asp-action="LinkedAccounts" class="mod-link">Связи аккаунтов</a>
        }
    </div>

    <div class="mod-card">
        <div class="mod-card-header">
            <span class="mod-card-icon">🎨</span>
            <h3 class="mod-card-title">Оформление</h3>
        </div>
        <a asp-action="Design" class="mod-link">Дизайн сайта</a>
        <a asp-action="FeaturedWorks" class="mod-link">Работы на главной</a>
    </div>

</div>

<hr />

<details class="mod-settings">
    <summary>
        <span style="font-size: 20px;">⚙️</span>
        Настройки каналов
    </summary>

    <div class="settings-body">
        <p>
            <i>
                Один раз настраиваются здесь, используются автоматически на всех страницах действий.
            </i>
        </p>

        <form asp-action="SaveChannels" method="post">
            <input type="hidden" asp-for="Settings.Id" />

            <div class="form-group">
                <label>Канал для голосования за тему</label>
                <select asp-for="Settings.ThemePollChannelId" asp-items="Model.ChannelList" class="form-control">
                    <option value="">-- Не выбрано --</option>
                </select>
            </div>

            <div class="form-group">
                <label>Канал для старта аниджема</label>
                <select asp-for="Settings.AnimJamStartChannelId" asp-items="Model.ChannelList" class="form-control">
                    <option value="">-- Не выбрано --</option>
                </select>
            </div>

            <div class="form-group">
                <label>Канал для голосования за победителя</label>
                <select asp-for="Settings.WinnerPollChannelId" asp-items="Model.ChannelList" class="form-control">
                    <option value="">-- Не выбрано --</option>
                </select>
            </div>

            <div class="form-group">
                <label>Канал для объявления победителей</label>
                <select asp-for="Settings.WinnersAnnouncementChannelId" asp-items="Model.ChannelList" class="form-control">
                    <option value="">-- Не выбрано --</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Сохранить настройки</button>
        </form>
    </div>
</details>