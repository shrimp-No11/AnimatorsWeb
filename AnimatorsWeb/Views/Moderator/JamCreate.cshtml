@model AnimatorsWeb.Models.CreateAnimJamViewModel
@using AnimatorsWeb.Models

@{
    bool isArtJam = Model.EventType == EventType.ArtJam;
    string eventName = isArtJam ? "АртДжема" : "АниДжема";
    ViewData["Title"] = $"Создание {eventName}";
    string formAction = isArtJam ? "ArtJamCreate" : "CreateAnimJam";
    string defaultTemplate = AnimatorsWeb.Services.JamAnnouncementTemplate.Default(Model.EventType);
}

<style>
    .ann-token-btn {
        padding: 5px 10px;
        border: 1px solid #bbb;
        border-radius: 6px;
        background: #fff;
        color: #333;
        font-size: 12px;
        cursor: grab;
        user-select: none;
    }
        .ann-token-btn:hover { border-color: var(--brand-accent); color: var(--brand-accent); }
        .ann-token-btn:active { cursor: grabbing; }

        .ann-token-btn img {
            height: 18px;
            width: 18px;
            vertical-align: middle;
            object-fit: cover;
        }

    .ann-token {
        display: inline;
        padding: 1px 5px;
        margin: 0 1px;
        border: 1px solid var(--brand-accent);
        border-radius: 5px;
        background: color-mix(in srgb, var(--brand-accent) 14%, var(--brand-card));
        color: var(--brand-accent);
        font-weight: 600;
        white-space: pre-wrap;
        user-select: none;
    }

        .ann-token img {
            height: 20px;
            width: 20px;
            vertical-align: middle;
            object-fit: cover;
        }
</style>

<h1>Создание @eventName</h1>

@if (TempData["Result"] != null)
{
    <p style="color: green;">@TempData["Result"]</p>
}
<div asp-validation-summary="All" style="color: red;"></div>

<div style="display: flex; gap: 30px;">
    <form asp-action="@formAction" method="post" style="flex: 1;">
        <div class="form-group">
            <label asp-for="Number">Номер:</label>
            <input asp-for="Number" type="number" class="form-control" id="inputNumber" />
        </div>

        <div class="form-group">
            <label asp-for="Theme">Тема:</label>
            <input asp-for="Theme" class="form-control" id="inputTheme" />
            @if (Model.WinningThemeFromPoll != null)
            {
                <small>
                    Из опроса: <b>@Model.WinningThemeFromPoll</b>
                    <button type="button" onclick="usePollTheme('@Model.WinningThemeFromPoll')">Применить</button>
                </small>
            }
            @if (Model.PollError != null)
            {
                <div style="margin-top: 5px;">
                    <small style="color: orange;">@Model.PollError</small>
                </div>
                @if (Model.TieCandidates.Any())
                {
                    <div style="margin-top: 5px; display: flex; gap: 5px; flex-wrap: wrap;">
                        @foreach (var t in Model.TieCandidates)
                        {
                            <button type="button" class="btn btn-primary"
                                    data-theme="@t"
                                    onclick="usePollTheme(this.dataset.theme)">
                                @t
                            </button>
                        }
                    </div>
                }
            }
        </div>

        <div class="form-group">
            <label>Дата и время окончания (ваш часовой пояс):</label>
            <input type="datetime-local" id="inputEndDate" class="form-control" />
            <input type="hidden" name="EndDate" id="hiddenEndDate"
                    value="@Model.EndDate.ToString("yyyy-MM-ddTHH:mm:ssZ")" />
        </div>

        <div class="form-group">
            <label asp-for="ChannelId">Канал для публикации:</label>
            <select asp-for="ChannelId" asp-items="Model.ChannelList" class="form-control">
                <option value="">-- Выберите канал --</option>
            </select>
        </div>

        <input type="hidden" name="AnnouncementTemplate" id="hiddenAnnouncementTemplate"
               value="@(Model.AnnouncementTemplate ?? "")" />

        <button type="submit" class="btn btn-primary">Опубликовать</button>
    </form>

    <div style="flex: 1; border: 1px solid #ccc; padding: 15px; border-radius: 8px; background: #f8f9fa;">
        <h3 style="margin-top: 0;">Объявление
            <small style="font-weight: normal; color: #777;">— текст можно редактировать</small>
        </h3>

        <div id="annToolbar" style="display: none; gap: 6px; flex-wrap: wrap; align-items: center;
                                    padding: 8px; margin-bottom: 8px; border: 1px dashed #aaa;
                                    border-radius: 8px; background: #fff;">
            <button type="button" class="ann-token-btn" data-token="number" draggable="true" title="Номер ивента">№</button>
            <button type="button" class="ann-token-btn" data-token="theme" draggable="true" title="Тема">Тема</button>
            <button type="button" class="ann-token-btn" data-token="deadline" draggable="true" title="Время окончания">Дедлайн</button>
            <button type="button" class="ann-token-btn" data-token="mentions" draggable="true" title="Упоминания ролей">Роли</button>
            <button type="button" class="ann-token-btn" data-token="star" draggable="true" title="✨">✨</button>
            <button type="button" class="ann-token-btn" data-token="hammer" draggable="true" title="🔨">🔨</button>
            <button type="button" class="ann-token-btn" data-token="goldpoop" draggable="true" title="Золотая какаха">@Html.Raw(AnimatorsWeb.Services.EmojiHelper.GoldPoopHtml)</button>
            <span style="display: inline-flex; gap: 4px; align-items: center;">
                <input type="text" id="annEmojiInput" placeholder="эмодзи или &lt;:name:id&gt;"
                       style="width: 150px; padding: 5px 8px; border: 1px solid #bbb; border-radius: 6px;" />
                <button type="button" id="annEmojiBtn" class="ann-token-btn">+ эмодзи</button>
            </span>
            <button type="button" id="annResetBtn" class="ann-token-btn" title="Вернуть стандартный текст">↺ Сбросить</button>
        </div>

        <div id="announcementEditor" contenteditable="true" spellcheck="false"
             style="min-height: 260px; white-space: pre-wrap; word-break: break-word;
                    font-family: monospace; font-size: 13px; line-height: 1.5;
                    border: 1px solid #ccc; border-radius: 6px; padding: 12px;
                    background: #fff; outline: none;">
        </div>

        <p style="color: #777; font-size: 12px; margin: 8px 0 0;">
            Нажми на текст, чтобы редактировать. Переменные выделены рамкой — кнопка выше вставит её туда,
            где стоит курсор. Кнопки можно перетащить в текст. «Сбросить» вернёт стандартный вариант.
        </p>
    </div>
</div>

<script>
    const initialUtc = "@Model.EndDate.ToString("yyyy-MM-ddTHH:mm:ss")";
    const isArtJam = @(isArtJam ? "true" : "false");
    const defaultTemplate = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(defaultTemplate));
    const initialTemplate = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AnnouncementTemplate ?? ""));
    const goldPoopHtml = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(AnimatorsWeb.Services.EmojiHelper.GoldPoopHtml));

    const inputNumber = document.getElementById('inputNumber');
    const inputTheme = document.getElementById('inputTheme');
    const inputEndDate = document.getElementById('inputEndDate');
    const hiddenEndDate = document.getElementById('hiddenEndDate');
    const editor = document.getElementById('announcementEditor');
    const toolbar = document.getElementById('annToolbar');
    const hiddenTemplate = document.getElementById('hiddenAnnouncementTemplate');
    const emojiInput = document.getElementById('annEmojiInput');

    function utcToLocalInputValue(utcString) {
        const d = new Date(utcString + 'Z');
        const pad = n => String(n).padStart(2, '0');
        return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
    }

    function localInputValueToUtc(localValue) {
        return new Date(localValue).toISOString();
    }

    function formatLocalReadable(localValue) {
        if (!localValue) return '(дата не указана)';
        const d = new Date(localValue);
        const pad = n => String(n).padStart(2, '0');
        const days = ['воскресенье', 'понедельник', 'вторник', 'среда', 'четверг', 'пятница', 'суббота'];
        const months = ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня',
            'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря'];

        return `${d.getDate()} ${months[d.getMonth()]} ${d.getFullYear()} г. ${pad(d.getHours())}:${pad(d.getMinutes())}`;
    }

    function plural(n, one, few, many) {
        const abs = Math.abs(n) % 100;
        const last = abs % 10;
        if (abs > 10 && abs < 20) return many;
        if (last > 1 && last < 5) return few;
        if (last === 1) return one;
        return many;
    }

    function formatRelative(localValue) {
        if (!localValue) return '';
        const diff = new Date(localValue).getTime() - Date.now();
        const sec = Math.floor(diff / 1000);
        const min = Math.floor(sec / 60);
        const hr = Math.floor(min / 60);
        const day = Math.floor(hr / 24);
        const abs = Math.abs;

        if (abs(day) >= 1) {
            const word = plural(day, 'день', 'дня', 'дней');
            return day >= 0 ? `через ${day} ${word}` : `${abs(day)} ${word} назад`;
        }
        if (abs(hr) >= 1) {
            const word = plural(hr, 'час', 'часа', 'часов');
            return hr >= 0 ? `через ${hr} ${word}` : `${abs(hr)} ${word} назад`;
        }
        if (abs(min) >= 1) {
            const word = plural(min, 'минуту', 'минуты', 'минут');
            return min >= 0 ? `через ${min} ${word}` : `${abs(min)} ${word} назад`;
        }
        return 'сейчас';
    }

    function splitToken(body) {
        const colon = body.indexOf(':');
        return colon < 0
            ? { name: body, arg: '' }
            : { name: body.substring(0, colon), arg: body.substring(colon + 1) };
    }

    function tokenLabel(name, arg) {
        switch (name) {
            case 'number': return inputNumber.value || '?';
            case 'theme': return inputTheme.value || '(тема)';
            case 'deadline': {
                const date = formatLocalReadable(inputEndDate.value);
                const rel = formatRelative(inputEndDate.value);
                return date + (rel ? ` (${rel})` : '');
            }
            case 'mentions': return isArtJam ? '@@Художник' : '@@2d Аниматор, @@3d Аниматор';
            case 'star': return '✨';
            case 'hammer': return '🔨';
            case 'goldpoop': return ''; // рисуем картинкой, как в Discord
            case 'emoji': return arg || '(эмодзи)';
            default: return '{{' + name + '}}';
        }
    }

    function makeToken(body) {
        const { name, arg } = splitToken(body);
        const span = document.createElement('span');
        span.className = 'ann-token';
        span.contentEditable = 'false';
        span.dataset.token = name;
        if (arg) span.dataset.arg = arg;
        if (name === 'goldpoop') span.innerHTML = goldPoopHtml;
        else span.textContent = tokenLabel(name, arg);
        return span;
    }

    function renderTemplate(template) {
        editor.innerHTML = '';
        for (let i = 0; i < template.length;) {
            const open = template.indexOf('{{', i);
            if (open < 0) {
                editor.appendChild(document.createTextNode(template.substring(i)));
                break;
            }
            if (open > i) editor.appendChild(document.createTextNode(template.substring(i, open)));
            const close = template.indexOf('}}', open + 2);
            if (close < 0) {
                editor.appendChild(document.createTextNode(template.substring(open)));
                break;
            }
            editor.appendChild(makeToken(template.substring(open + 2, close)));
            i = close + 2;
        }
        syncHidden();
    }

    function serializeTemplate() {
        let out = '';
        function walk(node) {
            if (node.nodeType === Node.TEXT_NODE) { out += node.nodeValue; return; }
            if (node.nodeType !== Node.ELEMENT_NODE) return;
            if (node.tagName === 'BR') { out += '\n'; return; }
            if (node.classList && node.classList.contains('ann-token')) {
                const name = node.dataset.token;
                out += name === 'emoji'
                    ? '{{emoji:' + (node.dataset.arg || '') + '}}'
                    : '{{' + name + '}}';
                return;
            }
            node.childNodes.forEach(walk);
            if (node.tagName === 'DIV' || node.tagName === 'P') out += '\n';
        }
        editor.childNodes.forEach(walk);
        return out.replace(/\n{3,}/g, '\n\n').trimEnd();
    }

    function syncHidden() {
        hiddenTemplate.value = serializeTemplate();
    }

    function updateTokenLabels() {
        editor.querySelectorAll('.ann-token').forEach(span => {
            if (span.dataset.token === 'goldpoop') span.innerHTML = goldPoopHtml;
            else span.textContent = tokenLabel(span.dataset.token, span.dataset.arg || '');
        });
        syncHidden();
    }

    let savedRange = null;
    function saveSelection() {
        const sel = window.getSelection();
        if (!sel || !sel.rangeCount) return;
        const range = sel.getRangeAt(0);
        if (editor.contains(range.commonAncestorContainer)) savedRange = range.cloneRange();
    }

    function targetRange(override) {
        if (override && editor.contains(override.commonAncestorContainer)) return override;
        if (savedRange && editor.contains(savedRange.commonAncestorContainer)) return savedRange;
        const range = document.createRange();
        range.selectNodeContents(editor);
        range.collapse(false);
        return range;
    }

    function insertNodeAt(node, override) {
        editor.focus();
        const range = targetRange(override);
        range.deleteContents();
        range.insertNode(node);
        range.setStartAfter(node);
        range.collapse(true);
        const sel = window.getSelection();
        sel.removeAllRanges();
        sel.addRange(range);
        savedRange = range.cloneRange();
        updateTokenLabels();
    }

    function insertToken(body, override) {
        insertNodeAt(makeToken(body), override);
    }

    function insertText(text, override) {
        insertNodeAt(document.createTextNode(text), override);
    }

    // Панель появляется, когда пользователь начал редактировать объявление.
    editor.addEventListener('focus', () => { toolbar.style.display = 'flex'; });
    editor.addEventListener('blur', () => {
        setTimeout(() => {
            if (!toolbar.contains(document.activeElement)) toolbar.style.display = 'none';
        }, 0);
    });

    document.addEventListener('selectionchange', () => {
        if (document.activeElement === editor) saveSelection();
    });
    editor.addEventListener('mouseup', saveSelection);
    editor.addEventListener('keyup', saveSelection);

    toolbar.querySelectorAll('.ann-token-btn[data-token]').forEach(btn => {
        // Не отдаём фокус кнопке, иначе курсор в тексте теряется.
        btn.addEventListener('mousedown', e => e.preventDefault());
        btn.addEventListener('click', () => insertToken(btn.dataset.token));
        btn.addEventListener('dragstart', e => {
            e.dataTransfer.setData('text/plain', '{{' + btn.dataset.token + '}}');
            e.dataTransfer.effectAllowed = 'copy';
        });
    });

    editor.addEventListener('dragover', e => { e.preventDefault(); e.dataTransfer.dropEffect = 'copy'; });
    editor.addEventListener('drop', e => {
        e.preventDefault();
        const raw = e.dataTransfer.getData('text/plain') || '';
        if (!raw) return;
        let range = null;
        if (document.caretRangeFromPoint) {
            range = document.caretRangeFromPoint(e.clientX, e.clientY);
        } else if (document.caretPositionFromPoint) {
            const p = document.caretPositionFromPoint(e.clientX, e.clientY);
            if (p) {
                range = document.createRange();
                range.setStart(p.offsetNode, p.offset);
                range.collapse(true);
            }
        }
        const match = /^\{\{(.+)\}\}$/.exec(raw);
        if (match) insertToken(match[1], range);
        else insertText(raw, range);
    });

    function insertEmoji() {
        const value = emojiInput.value.trim();
        if (!value) return;
        insertToken('emoji:' + value);
        emojiInput.value = '';
    }
    document.getElementById('annEmojiBtn').addEventListener('mousedown', e => e.preventDefault());
    document.getElementById('annEmojiBtn').addEventListener('click', insertEmoji);
    emojiInput.addEventListener('keydown', e => {
        if (e.key === 'Enter') { e.preventDefault(); insertEmoji(); }
    });

    document.getElementById('annResetBtn').addEventListener('mousedown', e => e.preventDefault());
    document.getElementById('annResetBtn').addEventListener('click', () => {
        renderTemplate(defaultTemplate);
        editor.focus();
    });

    editor.addEventListener('keydown', e => {
        if (e.key === 'Enter') {
            e.preventDefault();
            insertText('\n');
        }
    });
    editor.addEventListener('paste', e => {
        e.preventDefault();
        const text = (e.clipboardData || window.clipboardData).getData('text/plain');
        if (text) insertText(text);
    });
    editor.addEventListener('input', syncHidden);

    const theForm = editor.closest('form') || document.querySelector('form');
    theForm.addEventListener('submit', syncHidden);

    function usePollTheme(theme) {
        inputTheme.value = theme;
        updateTokenLabels();
    }

    // Инициализация
    inputEndDate.value = utcToLocalInputValue(initialUtc);
    hiddenEndDate.value = initialUtc;

    inputEndDate.addEventListener('input', () => {
        if (!inputEndDate.value) return;
        hiddenEndDate.value = localInputValueToUtc(inputEndDate.value);
        updateTokenLabels();
    });
    inputNumber.addEventListener('input', updateTokenLabels);
    inputTheme.addEventListener('input', updateTokenLabels);

    renderTemplate(initialTemplate || defaultTemplate);
</script>
