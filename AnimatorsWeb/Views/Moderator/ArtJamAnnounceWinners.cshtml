@model AnimatorsWeb.Models.ArtJamWinnersPageViewModel
@using AnimatorsWeb.Models

@{
    ViewData["Title"] = "АртДжем: объявление победителей";
}

<h1>АртДжем: объявление победителей</h1>

@if (Model.Message != null)
{
    <p style="color: darkblue;">@Model.Message</p>
}
@if (TempData["Result"] != null)
{
    <p style="color: green;">@TempData["Result"]</p>
}
@if (TempData["Info"] != null)
{
    <p style="color: darkblue;">@TempData["Info"]</p>
}
<div asp-validation-summary="All" style="color: red;"></div>

<h3>Выбор АртДжема</h3>
<form method="get" asp-action="ArtJamAnnounceWinners">
    <div class="form-group">
        <label>АртДжем:</label>
        <select name="artJamNumber" class="form-control" onchange="this.form.submit()">
            <option value="">-- Выберите АртДжем --</option>
            @foreach (var jam in Model.AllArtJams)
            {
                if (jam.Number == Model.ArtJamNumber)
                {
                    <option value="@jam.Number" selected>#@jam.Number — @jam.Theme</option>
                }
                else
                {
                    <option value="@jam.Number">#@jam.Number — @jam.Theme</option>
                }
            }
        </select>
    </div>
</form>

@if (Model.Winners.Any())
{
    <hr />
    <h3>Победители (@Model.Winners.Count)</h3>
    @if (Model.PollsCount > 1)
    {
        <p style="color: gray; font-size: 13px;">
            Голосование проходило в @Model.PollsCount сообщениях-опросах.
        </p>
    }

    <form asp-action="ArtJamAnnounceWinners" method="post">
        <input type="hidden" asp-for="ArtJamNumber" />
        <input type="hidden" asp-for="Theme" />
        <input type="hidden" asp-for="AnnouncementUrl" />
        <input type="hidden" asp-for="PublishChannelId" />
        <input type="hidden" asp-for="PollsCount" />

        @for (int w = 0; w < Model.Winners.Count; w++)
        {
            var winner = Model.Winners[w];
            <div style="border: 2px solid #888; padding: 15px; margin-bottom: 20px; border-radius: 8px;">

                <input type="hidden" asp-for="Winners[w].WorkUrl" />
                <input type="hidden" asp-for="Winners[w].MessageUrl" />
                <input type="hidden" asp-for="Winners[w].Votes" />
                <input type="hidden" asp-for="Winners[w].ParticipantId" />
                <input type="hidden" asp-for="Winners[w].PrimaryDiscordUserId" />

                <h4 style="margin-top: 0;">
                    🏆 @winner.Votes @(winner.Votes == 1 ? "голос" : "голосов")
                </h4>

                @for (int p = 0; p < winner.People.Count; p++)
                {
                    <input type="hidden" asp-for="Winners[w].People[p].DiscordUserId" />
                    <input type="hidden" asp-for="Winners[w].People[p].DisplayName" />
                    <span style="margin-right: 8px;">@winner.People[p].DisplayName</span>
                }

                <div style="margin-top: 12px;">
                    <div style="font-weight: 600; margin-bottom: 8px;">Арты для публикации:</div>
                    @if (winner.Attachments.Count == 0)
                    {
                        <p style="color: #b3261e; font-size: 13px;">
                            Вложений не найдено — возможно, сообщение удалено.
                        </p>
                    }
                    else
                    {
                        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                            @for (int a = 0; a < winner.Attachments.Count; a++)
                            {
                                var att = winner.Attachments[a];
                                <label style="display: flex; flex-direction: column; gap: 4px; cursor: pointer;
                                              border: 1px solid #ccc; border-radius: 8px; padding: 8px;
                                              background: @(att.Selected ? "#f0f8ff" : "#fafafa");">
                                    <input type="hidden" asp-for="Winners[w].Attachments[a].Index" />
                                    <input type="hidden" asp-for="Winners[w].Attachments[a].FileName" />
                                    <input type="hidden" asp-for="Winners[w].Attachments[a].Url" />
                                    <input type="checkbox" asp-for="Winners[w].Attachments[a].Selected"
                                           style="align-self: flex-start;" />
                                    <img src="/Media/StreamAttachment/@winner.ParticipantId/@att.Index"
                                         style="width: 120px; height: 80px; object-fit: cover;
                                                border-radius: 4px; background: #eee;"
                                         onerror="this.style.display='none';" />
                                    <span style="font-size: 11px; color: #666; max-width: 120px;
                                                 overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                        @att.FileName
                                    </span>
                                </label>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <button type="submit" class="btn btn-primary">Опубликовать победителей</button>
    </form>
}

<p style="margin-top: 20px;"><a asp-action="Index">← Назад в модераторскую</a></p>