@model AnimatorsWeb.Models.ChannelSelectViewModel
@using AnimatorsWeb.Models

@{
    bool isArtJam = Model.EventType == EventType.ArtJam;
    string eventName = isArtJam ? "ArtJam" : "AniJam";
    ViewData["Title"] = $"Голосование за тему {eventName}";
    var eventNumber = ViewBag.NextNumber ?? 1;
    string formAction = isArtJam ? "ArtJamPublishThemePoll" : "PublishThemePoll";
}

<style>
    .theme-form {
        max-width: 720px;
        margin-top: 20px;
    }

        .theme-form > .form-group {
            margin-bottom: 20px;
        }

            .theme-form > .form-group label {
                display: block;
                font-size: 12px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.6px;
                color: color-mix(in srgb, var(--brand-text) 55%, transparent);
                margin-bottom: 6px;
            }

            .theme-form > .form-group select {
                width: 100%;
                padding: 10px 14px;
                border: 1px solid color-mix(in srgb, var(--brand-text) 15%, transparent);
                border-radius: 8px;
                background: color-mix(in srgb, var(--brand-card) 70%, transparent);
                color: var(--brand-text);
                font-size: 15px;
            }

    /* Панель-рамка */
    .theme-panel {
        border: 1px solid color-mix(in srgb, var(--brand-text) 15%, transparent);
        border-radius: 12px;
        padding: 20px 22px;
        background: color-mix(in srgb, var(--brand-card) 60%, transparent);
        margin-bottom: 20px;
    }

    .theme-panel-title {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 16px;
        font-weight: 700;
        color: var(--brand-text);
        margin-bottom: 18px;
        flex-wrap: wrap;
    }

    .poll-token-toolbar {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        align-items: center;
        margin-bottom: 10px;
    }

    .poll-token-btn {
        padding: 5px 10px;
        border: 1px solid color-mix(in srgb, var(--brand-text) 20%, transparent);
        border-radius: 6px;
        background: color-mix(in srgb, var(--brand-card) 70%, transparent);
        color: var(--brand-text);
        font-size: 12px;
        cursor: grab;
        user-select: none;
    }

        .poll-token-btn:hover {
            border-color: var(--brand-accent);
            color: var(--brand-accent);
        }

        .poll-token-btn:active { cursor: grabbing; }

    .poll-title-editor {
        padding: 4px 8px;
        border: 1px solid color-mix(in srgb, var(--brand-text) 25%, transparent);
        border-radius: 6px;
        background: transparent;
        outline: none;
        transition: border-color 0.15s;
        line-height: 1.5;
    }

        .poll-title-editor:focus { border-color: var(--brand-primary); }

    .poll-token {
        display: inline;
        padding: 1px 5px;
        margin: 0 1px;
        border: 1px solid var(--brand-accent);
        border-radius: 5px;
        background: color-mix(in srgb, var(--brand-accent) 14%, var(--brand-card));
        color: var(--brand-accent);
        font-weight: 600;
        white-space: pre-wrap;
        user-select: none;
    }

        .poll-token[contenteditable="true"] {
            user-select: text;
            cursor: text;
        }

    .theme-panel-subtitle {
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        color: color-mix(in srgb, var(--brand-text) 55%, transparent);
        margin-bottom: 10px;
    }

    .theme-options {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 12px;
    }

    .theme-option {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 4px;
        border: 1px solid color-mix(in srgb, var(--brand-text) 15%, transparent);
        border-radius: 8px;
        background: color-mix(in srgb, var(--brand-card) 70%, transparent);
        transition: border-color 0.15s;
    }

        .theme-option:focus-within {
            border-color: var(--brand-primary);
        }

    .theme-num {
        flex-shrink: 0;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: color-mix(in srgb, var(--brand-primary) 20%, transparent);
        color: var(--brand-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 13px;
        margin-left: 4px;
    }

    .theme-option input {
        flex: 1;
        min-width: 0;
        padding: 10px 6px;
        border: none;
        background: transparent;
        color: var(--brand-text);
        font-size: 14px;
        outline: none;
    }

        .theme-option input::placeholder {
            color: color-mix(in srgb, var(--brand-text) 40%, transparent);
        }

    .theme-remove {
        flex-shrink: 0;
        width: 32px;
        height: 32px;
        margin-right: 2px;
        border: none;
        background: transparent;
        color: color-mix(in srgb, var(--brand-text) 45%, transparent);
        font-size: 22px;
        line-height: 1;
        cursor: pointer;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.15s, color 0.15s;
    }

        .theme-remove:hover {
            background: color-mix(in srgb, #b3261e 15%, transparent);
            color: #b3261e;
        }

    .theme-add {
        padding: 9px 16px;
        border: 1px dashed color-mix(in srgb, var(--brand-text) 25%, transparent);
        background: transparent;
        color: color-mix(in srgb, var(--brand-text) 70%, transparent);
        border-radius: 8px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 16px;
        transition: border-color 0.15s, color 0.15s;
    }

        .theme-add:hover {
            border-color: var(--brand-primary);
            color: var(--brand-primary);
        }

    .theme-check {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        font-size: 13px;
        color: color-mix(in srgb, var(--brand-text) 75%, transparent);
        padding-top: 12px;
        border-top: 1px solid color-mix(in srgb, var(--brand-text) 10%, transparent);
        width: 100%;
    }

        .theme-check input[type="checkbox"] {
            width: 16px;
            height: 16px;
            accent-color: var(--brand-primary);
            cursor: pointer;
        }

    .theme-result {
        padding: 10px 14px;
        border-radius: 8px;
        margin-bottom: 16px;
        font-size: 14px;
    }

        .theme-result.ok {
            background: #e7f7ec;
            color: #1a7f37;
            border: 1px solid #b9e5c4;
        }

        .theme-result.err {
            background: #fdecea;
            color: #b3261e;
            border: 1px solid #f5c2be;
        }
</style>


@if (ViewBag.Error != null)
{
    <div class="theme-result err">@ViewBag.Error</div>
}
@if (ViewBag.Result != null)
{
    <div class="theme-result ok">@ViewBag.Result</div>
}

<form asp-action="@formAction" method="post" class="theme-form">

    <div class="form-group">
        <label asp-for="SelectedChannelId">Канал для публикации</label>
        <select asp-for="SelectedChannelId" asp-items="Model.ChannelList">
            <option value="">-- Выберите канал --</option>
        </select>
    </div>

    <div class="theme-panel">
        <div class="theme-panel-title">
            <div id="pollQuestion" class="poll-title-editor" contenteditable="true" spellcheck="false"></div>
        </div>

        <div id="pollQuestionToolbar" class="poll-token-toolbar" style="display: none;">
            <button type="button" class="poll-token-btn" data-token="event" draggable="true" title="Название ивента">@(isArtJam ? "АртДжем" : "АниДжем")</button>
            <button type="button" class="poll-token-btn" data-token="number" draggable="true" title="Номер ивента">@eventNumber</button>
        </div>

        <input type="hidden" name="animJamNumber" id="hiddenEventNumber" value="@eventNumber" />
        <input type="hidden" name="pollTitleTemplate" id="hiddenPollTitle"
               value="@(Model.PollTitleTemplate ?? "")" />

        <div class="theme-panel-subtitle">Варианты</div>

        <div id="themes-container" class="theme-options">
            @for (int i = 0; i < 4; i++)
            {
                <div class="theme-option">
                    <span class="theme-num">@(i + 1)</span>
                    <input type="text" name="themes"/>
                    <button type="button" class="theme-remove" onclick="removeTheme(this)" title="Удалить">×</button>
                </div>
            }
        </div>

        <button type="button" class="theme-add" onclick="addTheme()">+ Добавить вариант</button>

        <label class="theme-check">
            <input type="checkbox" name="allowMulti" value="true" />
            <span>Разрешить несколько вариантов ответа</span>
        </label>
    </div>

    <button type="submit" class="btn btn-primary">Опубликовать голосование</button>
</form>

<p style="margin-top: 24px;"><a asp-action="Index">← Назад в модераторскую</a></p>

<script>
    const container = document.getElementById('themes-container');
    const MAX = 10;
    const MIN = 2;

    function addTheme() {
        const rows = container.querySelectorAll('.theme-option');
        if (rows.length >= MAX) {
            alert('Максимум 10 тем');
            return;
        }

        const row = document.createElement('div');
        row.className = 'theme-option';
        row.innerHTML = `
            <span class="theme-num"></span>
            <input type="text" name="themes" />
            <button type="button" class="theme-remove" onclick="removeTheme(this)" title="Удалить">×</button>
        `;
        container.appendChild(row);
        renumber();
    }

    function removeTheme(btn) {
        const rows = container.querySelectorAll('.theme-option');
        if (rows.length <= MIN) {
            alert('Должно быть минимум 2 темы');
            return;
        }
        btn.closest('.theme-option').remove();
        renumber();
    }

    function renumber() {
        container.querySelectorAll('.theme-option').forEach((row, i) => {
            row.querySelector('.theme-num').textContent = i + 1;
            row.querySelector('input').placeholder = `Тема ${i + 1}`;
        });
    }

    // === Редактируемый заголовок опроса ===
    const questionEditor = document.getElementById('pollQuestion');
    const questionToolbar = document.getElementById('pollQuestionToolbar');
    const hiddenQuestion = document.getElementById('hiddenPollTitle');
    const hiddenEventNumber = document.getElementById('hiddenEventNumber');
    const initialQuestion = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PollTitleTemplate ?? ""));
    const defaultQuestion = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(AnimatorsWeb.Services.JamAnnouncementTemplate.DefaultThemePollQuestion(Model.EventType)));
    const eventChipLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(isArtJam ? "АртДжем" : "АниДжем"));
    const initialNumber = "@eventNumber";

    function questionTokenLabel(name, arg) {
        if (name === 'event') return eventChipLabel;
        if (name === 'number') return hiddenEventNumber.value || initialNumber;
        if (name === 'emoji') return arg || '(эмодзи)';
        return '{{' + name + '}}';
    }

    function makeQuestionToken(body) {
        const colon = body.indexOf(':');
        const name = colon < 0 ? body : body.substring(0, colon);
        const arg = colon < 0 ? '' : body.substring(colon + 1);

        const span = document.createElement('span');
        span.className = 'poll-token';
        span.contentEditable = name === 'number' ? 'true' : 'false';
        span.dataset.token = name;
        if (arg) span.dataset.arg = arg;
        span.textContent = questionTokenLabel(name, arg);
        return span;
    }

    function renderQuestion(template) {
        questionEditor.innerHTML = '';
        for (let i = 0; i < template.length;) {
            const open = template.indexOf('{{', i);
            if (open < 0) {
                questionEditor.appendChild(document.createTextNode(template.substring(i)));
                break;
            }
            if (open > i) questionEditor.appendChild(document.createTextNode(template.substring(i, open)));
            const close = template.indexOf('}}', open + 2);
            if (close < 0) {
                questionEditor.appendChild(document.createTextNode(template.substring(open)));
                break;
            }
            questionEditor.appendChild(makeQuestionToken(template.substring(open + 2, close)));
            i = close + 2;
        }
        syncQuestion();
    }

    function serializeQuestion() {
        let out = '';
        function walk(node) {
            if (node.nodeType === Node.TEXT_NODE) {
                out += node.nodeValue.replace(/[\r\n]+/g, ' ');
                return;
            }
            if (node.nodeType !== Node.ELEMENT_NODE) return;
            if (node.tagName === 'BR') { out += ' '; return; }
            if (node.classList && node.classList.contains('poll-token')) {
                const name = node.dataset.token;
                out += name === 'emoji'
                    ? '{{emoji:' + (node.dataset.arg || '') + '}}'
                    : '{{' + name + '}}';
                return;
            }
            node.childNodes.forEach(walk);
        }
        questionEditor.childNodes.forEach(walk);
        return out.trim();
    }

    function syncQuestion() {
        hiddenQuestion.value = serializeQuestion();
    }

    function updateToolbarLabels() {
        questionToolbar.querySelectorAll('.poll-token-btn[data-token]').forEach(btn => {
            btn.textContent = questionTokenLabel(btn.dataset.token, '');
        });
    }

    function updateQuestionTokens() {
        questionEditor.querySelectorAll('.poll-token').forEach(span => {
            // Число пользователь редактирует сам — не перезаписываем его
            if (span.dataset.token !== 'number')
                span.textContent = questionTokenLabel(span.dataset.token, span.dataset.arg || '');
        });
        updateToolbarLabels();
        syncQuestion();
    }

    let questionRange = null;
    function saveQuestionSelection() {
        const sel = window.getSelection();
        if (!sel || !sel.rangeCount) return;
        const range = sel.getRangeAt(0);
        if (questionEditor.contains(range.commonAncestorContainer)) questionRange = range.cloneRange();
    }

    function questionTargetRange(override) {
        if (override && questionEditor.contains(override.commonAncestorContainer)) return override;
        if (questionRange && questionEditor.contains(questionRange.commonAncestorContainer)) return questionRange;
        const range = document.createRange();
        range.selectNodeContents(questionEditor);
        range.collapse(false);
        return range;
    }

    function insertQuestionNode(node, override) {
        questionEditor.focus();
        const range = questionTargetRange(override);
        range.deleteContents();
        range.insertNode(node);
        range.setStartAfter(node);
        range.collapse(true);
        const sel = window.getSelection();
        sel.removeAllRanges();
        sel.addRange(range);
        questionRange = range.cloneRange();
        updateQuestionTokens();
    }

    // Панель переменных появляется только во время редактирования заголовка
    questionEditor.addEventListener('focus', () => { questionToolbar.style.display = 'flex'; });
    questionEditor.addEventListener('blur', () => {
        setTimeout(() => {
            if (!questionToolbar.contains(document.activeElement)) questionToolbar.style.display = 'none';
        }, 0);
    });

    questionToolbar.querySelectorAll('.poll-token-btn[data-token]').forEach(btn => {
        btn.addEventListener('mousedown', e => e.preventDefault());
        btn.addEventListener('click', () => {
            insertQuestionNode(makeQuestionToken(btn.dataset.token));
        });
        btn.addEventListener('dragstart', e => {
            e.dataTransfer.setData('text/plain', '{{' + btn.dataset.token + '}}');
            e.dataTransfer.effectAllowed = 'copy';
        });
    });

    questionEditor.addEventListener('dragover', e => { e.preventDefault(); e.dataTransfer.dropEffect = 'copy'; });
    questionEditor.addEventListener('drop', e => {
        e.preventDefault();
        const raw = e.dataTransfer.getData('text/plain') || '';
        if (!raw) return;
        let range = null;
        if (document.caretRangeFromPoint) {
            range = document.caretRangeFromPoint(e.clientX, e.clientY);
        } else if (document.caretPositionFromPoint) {
            const p = document.caretPositionFromPoint(e.clientX, e.clientY);
            if (p) {
                range = document.createRange();
                range.setStart(p.offsetNode, p.offset);
                range.collapse(true);
            }
        }
        const match = /^\{\{(.+)\}\}$/.exec(raw);
        insertQuestionNode(match ? makeQuestionToken(match[1]) : document.createTextNode(raw.replace(/[\r\n]+/g, ' ')), range);
    });

    document.addEventListener('selectionchange', () => {
        if (document.activeElement === questionEditor) saveQuestionSelection();
    });
    questionEditor.addEventListener('mouseup', saveQuestionSelection);
    questionEditor.addEventListener('keyup', saveQuestionSelection);

    // Клик по номеру выделяет его для замены
    questionEditor.addEventListener('click', e => {
        if (!(e.target instanceof Element)) return;
        const chip = e.target.closest('.poll-token[data-token="number"]');
        if (!chip || !questionEditor.contains(chip)) return;
        const range = document.createRange();
        range.selectNodeContents(chip);
        const sel = window.getSelection();
        sel.removeAllRanges();
        sel.addRange(range);
        saveQuestionSelection();
    });

    // Вопрос опроса — одна строка
    questionEditor.addEventListener('keydown', e => {
        if (e.key === 'Enter') e.preventDefault();
    });
    questionEditor.addEventListener('paste', e => {
        e.preventDefault();
        const text = (e.clipboardData || window.clipboardData).getData('text/plain');
        if (text) insertQuestionNode(document.createTextNode(text.replace(/[\r\n]+/g, ' ')));
    });

    questionEditor.addEventListener('input', e => {
        if (e.target instanceof Element && e.target.classList.contains('poll-token') &&
            e.target.dataset.token === 'number') {
            const digits = (e.target.textContent.match(/\d+/g) || []).join('');
            if (digits) hiddenEventNumber.value = digits;
            updateToolbarLabels();
        }
        syncQuestion();
    });

    questionEditor.addEventListener('focusout', e => {
        if (!(e.target instanceof Element) || !e.target.classList.contains('poll-token') ||
            e.target.dataset.token !== 'number') return;
        const digits = (e.target.textContent.match(/\d+/g) || []).join('');
        if (digits) hiddenEventNumber.value = digits;
        e.target.textContent = hiddenEventNumber.value || initialNumber;
        updateToolbarLabels();
        syncQuestion();
    });

    questionEditor.closest('form').addEventListener('submit', () => {
        if (!/^\d+$/.test(hiddenEventNumber.value)) hiddenEventNumber.value = initialNumber;
        syncQuestion();
    });

    renderQuestion(initialQuestion || defaultQuestion);
</script>