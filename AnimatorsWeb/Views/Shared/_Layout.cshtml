@inject AnimatorsWeb.Services.DesignSettingsService DesignService
@{
    var __design = await DesignService.GetAsync();
    var bgDecorationUrl = DesignService.GetBackgroundDecorationUrl(__design);
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string ActiveClass(string c) => c == currentController ? "nav-link active" : "nav-link";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Сообщество Аниматоров — @ViewData["Title"]</title>
    <meta name="description" content="@ViewData["Description"]" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/media-modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AnimatorsWeb.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --brand-bg: @__design.BackgroundColor;
            --brand-text: @__design.TextColor;
            --brand-primary: @__design.PrimaryColor;
            --brand-primary-hover: @__design.PrimaryHoverColor;
            --brand-accent: @__design.AccentColor;
            --brand-card: @__design.CardColor;
            --font-heading: 'Nunito', system-ui, -apple-system, sans-serif;
            --font-body: 'Inter', system-ui, -apple-system, sans-serif;
            --surface-border: color-mix(in srgb, var(--brand-text) 10%, transparent);
            --surface-muted: color-mix(in srgb, var(--brand-text) 5%, transparent);
            --bg-decoration-image: @Html.Raw(string.IsNullOrEmpty(bgDecorationUrl) ? "none" : $"url('{bgDecorationUrl}')");
            --bg-decoration-repeat: @(__design.RepeatBackgroundDecoration ? "repeat-y" : "no-repeat");
        }

        html, body { min-height: 100%; }
        html { scroll-padding-top: 88px; }
        body {
            background-color: var(--brand-bg);
            background-image:
                var(--bg-decoration-image),
                radial-gradient(ellipse at 12% 0%, color-mix(in srgb, var(--brand-primary) 8%, transparent), transparent 36rem),
                radial-gradient(ellipse at 92% 24%, color-mix(in srgb, var(--brand-accent) 7%, transparent), transparent 32rem);
            background-position: center top, center center, center center;
            background-size: 100% auto, auto, auto;
            background-repeat: var(--bg-decoration-repeat), no-repeat, no-repeat;
            color: var(--brand-text);
            font-family: var(--font-body);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        h1, h2, h3, h4, h5, h6 {
            font-family: var(--font-heading);
            font-weight: 800;
        }
        a { color: var(--brand-primary); }
        a:hover { color: var(--brand-primary-hover); }
        .btn-primary {
            background-color: var(--brand-primary) !important;
            border-color: var(--brand-primary) !important;
        }
        .btn-primary:hover, .btn-primary:focus {
            background-color: var(--brand-primary-hover) !important;
            border-color: var(--brand-primary-hover) !important;
        }

        /* Шапка: цвет темы плавно растворяется в поверхности сайта. */
        .site-header {
            position: sticky;
            top: 0;
            z-index: 100;
            isolation: isolate;
            background: linear-gradient(180deg,
                color-mix(in srgb, var(--brand-primary) 15%, var(--brand-card)) 0%,
                color-mix(in srgb, var(--brand-accent) 7%, var(--brand-card)) 48%,
                var(--brand-card) 100%);
            border-bottom: 1px solid var(--surface-border);
            box-shadow: 0 8px 28px color-mix(in srgb, var(--brand-text) 7%, transparent);
            transition: transform .28s ease, box-shadow .28s ease;
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }
        .site-header::before {
            content: "";
            position: absolute;
            z-index: -1;
            inset: 0 0 auto;
            height: 3px;
            background: linear-gradient(90deg, var(--brand-primary), var(--brand-accent), color-mix(in srgb, var(--brand-primary) 30%, transparent));
            opacity: .85;
        }
        .site-header.hidden { transform: translateY(-100%); box-shadow: none; }
        .site-header .navbar { padding: 12px 0; }
        .site-header .navbar > .container { gap: 18px; }
        .site-header .navbar-brand {
            font-family: var(--font-heading);
            font-weight: 800;
            font-size: clamp(16px, 1.3vw, 20px);
            letter-spacing: -.035em;
            color: var(--brand-text) !important;
            display: flex;
            align-items: center;
            gap: 10px;
            white-space: nowrap;
            margin-right: 10px;
        }
        .site-header .navbar-brand img {
            width: 38px;
            height: 38px;
            border-radius: 13px;
            object-fit: cover;
            box-shadow: 0 3px 10px color-mix(in srgb, var(--brand-text) 14%, transparent);
        }
        .site-header .navbar-nav { align-items: center; gap: 4px; }
        .site-header .nav-link {
            position: relative;
            color: var(--brand-text) !important;
            font-size: 14px;
            font-weight: 700;
            padding: 9px 13px !important;
            border-radius: 11px;
            transition: background-color .18s ease, color .18s ease, transform .18s ease;
        }
        .site-header .nav-link:hover {
            background: color-mix(in srgb, var(--brand-primary) 9%, transparent);
            color: var(--brand-primary) !important;
        }
        .site-header .nav-link.active {
            color: var(--brand-primary) !important;
            background: color-mix(in srgb, var(--brand-primary) 11%, transparent);
        }
        .site-header .nav-link.active:not(.cta)::after {
            content: "";
            position: absolute;
            left: 13px;
            right: 13px;
            bottom: 3px;
            height: 2px;
            border-radius: 2px;
            background: var(--brand-accent);
        }
        .site-header .nav-link.cta {
            background: var(--brand-primary);
            color: #fff !important;
            padding: 10px 17px !important;
            border-radius: 12px;
            box-shadow: 0 4px 12px color-mix(in srgb, var(--brand-primary) 24%, transparent);
        }
        .site-header .nav-link.cta:hover {
            background: var(--brand-primary-hover);
            color: #fff !important;
            transform: translateY(-1px);
            box-shadow: 0 6px 16px color-mix(in srgb, var(--brand-primary) 30%, transparent);
        }
        .site-header .navbar-toggler {
            border-color: var(--surface-border);
            border-radius: 12px;
            padding: 7px 10px;
            box-shadow: none;
        }
        .site-header .navbar-toggler:focus { box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand-primary) 16%, transparent); }
        .site-header .navbar-toggler-icon { filter: none; }

        .user-chip {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 13px;
            border: 1px solid var(--surface-border);
            border-radius: 999px;
            background: color-mix(in srgb, var(--brand-card) 70%, transparent);
            color: var(--brand-text);
            font-size: 14px;
            text-decoration: none;
            font-weight: 700;
            max-width: 220px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            transition: background .18s ease, border-color .18s ease;
        }
        .user-chip:hover {
            background: color-mix(in srgb, var(--brand-primary) 8%, var(--brand-card));
            border-color: color-mix(in srgb, var(--brand-primary) 25%, transparent);
            color: var(--brand-text);
        }

        /* Контент сохраняет тему, а мягкие цветовые пятна убирают ощущение плоского фона. */
        .site-main { flex: 1; position: relative; }
        .site-main .container { padding-top: 28px; padding-bottom: 28px; }

        .site-footer {
            position: relative;
            overflow: hidden;
            background: linear-gradient(180deg,
                color-mix(in srgb, var(--brand-card) 78%, var(--brand-bg)) 0%,
                var(--brand-bg) 100%);
            border-top: 1px solid var(--surface-border);
            padding: 27px 0;
            margin-top: 44px;
            color: color-mix(in srgb, var(--brand-text) 68%, transparent);
            font-size: 13px;
            text-align: center;
        }
        .site-footer::before {
            content: "";
            position: absolute;
            width: min(520px, 80vw);
            height: 100px;
            left: 50%;
            top: -80px;
            transform: translateX(-50%);
            border-radius: 50%;
            background: color-mix(in srgb, var(--brand-accent) 12%, transparent);
            filter: blur(35px);
            pointer-events: none;
        }
        .site-footer .container { position: relative; }
        .site-footer a {
            color: var(--brand-primary);
            font-weight: 700;
            text-decoration: none;
            text-underline-offset: 3px;
        }
        .site-footer a:hover { color: var(--brand-primary-hover); text-decoration: underline; }
        /* Виджет «Сегодня» в шапке */
        .today-events-nav {
            display: flex;
            align-items: center;
            margin-left: 4px;
        }
        .today-events-widget {
            --te-accent: var(--brand-primary);
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 13px;
            border-radius: 11px;
            background: color-mix(in srgb, var(--brand-primary) 7%, transparent);
            color: var(--brand-text);
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: background-color .18s ease, color .18s ease;
            max-width: 340px;
            overflow: hidden;
            user-select: none;
            border: none;
            box-shadow: none;
        }
        .today-events-widget:hover {
            background: color-mix(in srgb, var(--brand-primary) 12%, transparent);
        }
        .today-events-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--te-accent);
            flex-shrink: 0;
            opacity: .85;
        }
        .today-events-title {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            min-width: 0;
            line-height: 1.3;
        }
        .today-events-title-track {
            display: inline-flex;
            width: max-content;
            white-space: nowrap;
            will-change: transform;
        }
        .today-events-title.is-scrolling .today-events-title-track {
            animation: today-events-marquee var(--marquee-duration, 10s) linear infinite;
        }
        .today-events-title.is-scrolling .today-events-title-segment {
            padding-right: 42px;
        }
        .today-events-widget:hover .today-events-title-track {
            animation-play-state: paused;
        }
        @@keyframes today-events-marquee {
            from { transform: translateX(0); }
            to { transform: translateX(-50%); }
        }
        @@media (prefers-reduced-motion: reduce) {
            .today-events-title.is-scrolling .today-events-title-track {
                animation: none;
            }
        }
        .today-events-counter {
            flex-shrink: 0;
            font-size: 11px;
            font-weight: 700;
            color: color-mix(in srgb, var(--brand-text) 55%, transparent);
            letter-spacing: .2px;
            line-height: 1.2;
        }
        .today-events-widget.color-primary { --te-accent: var(--brand-primary); }
        .today-events-widget.color-accent  { --te-accent: var(--brand-accent); }
        .today-events-widget.color-hover   { --te-accent: var(--brand-primary-hover); }
        .today-events-widget.color-text    { --te-accent: color-mix(in srgb, var(--brand-text) 65%, transparent); }
        .today-events-widget.color-bg      { --te-accent: color-mix(in srgb, var(--brand-text) 40%, var(--brand-bg)); }

        @@media (max-width: 767.98px) {
            .today-events-nav {
                margin: 4px 0 0;
                width: 100%;
            }
            .today-events-widget {
                width: 100%;
                max-width: none;
                box-sizing: border-box;
                justify-content: center;
            }
        }
        @@media (max-width: 991.98px) {
            .site-header .navbar > .container { gap: 10px; }
            .site-header .navbar-brand { margin-right: 0; }
            .site-header .nav-link { padding: 9px 10px !important; }
        }
        @@media (max-width: 767.98px) {
            .site-header .navbar { padding: 10px 0; }
            .site-header .navbar-collapse {
                padding: 14px 0 4px;
                margin-top: 10px;
                border-top: 1px solid var(--surface-border);
            }
            .site-header .navbar-nav { align-items: stretch; gap: 5px; }
            .site-header .nav-link { padding: 11px 13px !important; }
            .site-header .nav-link.active:not(.cta)::after { display: none; }
            .site-header .nav-link.cta { text-align: center; margin-top: 5px; }
            .site-header .navbar-nav + .navbar-nav { margin-top: 8px; }
            .user-chip { width: 100%; max-width: none; justify-content: center; margin-top: 4px; }
            .site-main .container { padding-top: 20px; padding-bottom: 20px; }
            .site-footer { margin-top: 28px; padding: 23px 0; }
        }

        @@media (prefers-reduced-motion: reduce) {
            .site-header, .site-header .nav-link, .site-header .nav-link.cta, .user-chip { transition: none; }
        }
        @@media (max-width: 991.98px) {
            :root {
                --bg-decoration-image: none;
            }
        }
    </style>
</head>
<body data-media-initial-volume="20">
    <header class="site-header">
        <nav class="navbar navbar-expand-md">
            <div class="container">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    @{
                        var brandAvatar = DesignService.GetLocalAvatarUrl() ?? DesignService.GetGuildIconUrl();
                    }
                    @if (!string.IsNullOrEmpty(brandAvatar))
                    {
                        <img src="@brandAvatar" alt="" />
                    }
                    Сообщество Аниматоров
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNav" aria-controls="mainNav"
                        aria-expanded="false" aria-label="Меню">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0">
                        <li class="nav-item">
                            <a class="@ActiveClass("Events")" asp-controller="Events" asp-action="Index">Ивенты</a>
                        </li>
                        <li class="nav-item">
                            <a class="@ActiveClass("Participants")" asp-controller="Participants" asp-action="Index">Участники</a>
                        </li>
                        <li class="nav-item">
                            <a class="@ActiveClass("Calendar")" asp-controller="Calendar" asp-action="Index">Календарь</a>
                        </li>
                        @if (User.HasClaim("is_moderator", "true"))
                        {
                            <li class="nav-item">
                                <a class="@ActiveClass("Moderator")" asp-controller="Moderator" asp-action="Index">Модераторская</a>
                            </li>
                        }
                        <li class="nav-item today-events-nav" id="todayEventsWidget" style="display:none;">
                            <div class="today-events-widget color-primary" title="">
                                <span class="today-events-dot"></span>
                                <span class="today-events-title" id="todayEventsTitle"><span class="today-events-title-track" id="todayEventsContent"></span></span>
                                <span class="today-events-counter" id="todayEventsCounter" style="display:none;"></span>
                            </div>
                        </li>
                    </ul>

                    <ul class="navbar-nav">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="user-chip" asp-controller="User" asp-action="Profile">
                                    👤 @User.Identity.Name
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Logout">Выйти</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link cta" asp-controller="Account" asp-action="Login">Войти через Discord</a>
                            </li>
                        }
                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <div class="site-main">
        <main role="main" class="container">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container">
            Сообщество Аниматоров —
            <a href="@SiteLinks.Discord" target="_blank" rel="noopener">наш Discord-сервер</a>
            <span class="footer-sep">·</span>
            <a href="@SiteLinks.Donate"
               target="_blank"
               rel="sponsored noopener"
               class="footer-donate-link">
                ❤️ Поддержать проект
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        window.MEDIA_MODAL_INITIAL_VOLUME = parseInt(
            document.body.dataset.mediaInitialVolume || '30', 10
        );
    </script>

    <script>
        (function () {
            const header = document.querySelector('.site-header');
            if (!header) return;

            let lastScroll = window.scrollY;
            const threshold = 10;        // на сколько пикселей надо прокрутить, чтобы среагировать
            const showAtTop = 80;        // до этой позиции шапка всегда видна

            window.addEventListener('scroll', () => {
                const current = window.scrollY;

                // У самого верха — всегда показываем
                if (current <= showAtTop) {
                    header.classList.remove('hidden');
                    lastScroll = current;
                    return;
                }

                const diff = current - lastScroll;

                if (Math.abs(diff) < threshold) return;

                if (diff > 0) {
                    // Скролл вниз — прячем
                    header.classList.add('hidden');
                } else {
                    // Скролл вверх — показываем
                    header.classList.remove('hidden');
                }

                lastScroll = current;
            }, { passive: true });
        })();
    </script>
    <script>
    (function () {
        fetch('/Home/TodayEventsJson')
            .then(r => r.json())
            .then(events => {
                if (!events || !events.length) return;

                const now = new Date();
                const todayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate());
                const todayEnd = new Date(todayStart.getTime() + 24 * 60 * 60 * 1000);

                const todays = events
                    .map(e => ({
                        id: e.id,
                        title: e.title,
                        color: e.color,
                        start: new Date(e.startUtc),
                        end: new Date(e.endUtc)
                    }))
                    .filter(e => e.end > todayStart && e.start < todayEnd)
                    .sort((a, b) => a.start - b.start);

                if (!todays.length) return;

                const widgetLi = document.getElementById('todayEventsWidget');
                const content = document.getElementById('todayEventsContent');
                const titleEl = document.getElementById('todayEventsTitle');
                const counter = document.getElementById('todayEventsCounter');
                if (!widgetLi || !content || !titleEl) return;

                const widget = widgetLi.querySelector('.today-events-widget');
                let idx = 0;

                // Если заголовок не влезает — превращаем его в бегущую строку:
                // дублируем текст и двигаем дорожку на половину её ширины (бесшовно).
                function setWidgetTitle(text) {
                    content.innerHTML = '';
                    titleEl.classList.remove('is-scrolling');
                    content.style.removeProperty('--marquee-duration');

                    const segment = document.createElement('span');
                    segment.className = 'today-events-title-segment';
                    segment.textContent = text;
                    content.appendChild(segment);

                    // Ширины известны только после раскладки.
                    requestAnimationFrame(() => {
                        if (content.scrollWidth - titleEl.clientWidth <= 1) return;

                        const clone = segment.cloneNode(true);
                        clone.setAttribute('aria-hidden', 'true');
                        content.appendChild(clone);
                        titleEl.classList.add('is-scrolling');

                        // ~45 px/с, но не быстрее 6 секунд на круг.
                        const half = content.scrollWidth / 2;
                        content.style.setProperty('--marquee-duration',
                            `${Math.max(6, Math.round(half / 45))}s`);
                    });
                }

                function render() {
                    const e = todays[idx];
                    const time = e.start.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });
                    setWidgetTitle(`${time} · ${e.title}`);

                    if (widget) {
                        widget.className = 'today-events-widget color-' + (e.color || 'primary');
                        widget.title = todays.length > 1
                            ? `${time} · ${e.title} (клик — следующее, ${idx + 1}/${todays.length})`
                            : `${time} · ${e.title}`;
                    }

                    if (counter) {
                        if (todays.length > 1) {
                            counter.style.display = 'inline-block';
                            counter.textContent = `${idx + 1}/${todays.length}`;
                        } else {
                            counter.style.display = 'none';
                        }
                    }
                }

                // Показываем до замера: у скрытого элемента ширина нулевая.
                widgetLi.style.display = 'flex';
                render();

                if (todays.length > 1 && widget) {
                    widget.addEventListener('click', () => {
                        idx = (idx + 1) % todays.length;
                        render();
                    });
                }
            })
            .catch(() => {});
    })();
    </script>
    <script src="~/js/media-modal.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>