@inject AnimatorsWeb.Services.DesignSettingsService DesignService
@{
    var __design = await DesignService.GetAsync();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string ActiveClass(string c) => c == currentController ? "nav-link active" : "nav-link";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — AnimatorsWeb</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AnimatorsWeb.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --brand-bg: @__design.BackgroundColor;
            --brand-text: @__design.TextColor;
            --brand-primary: @__design.PrimaryColor;
            --brand-primary-hover: @__design.PrimaryHoverColor;
            --brand-accent: @__design.AccentColor;
            --brand-card: @__design.CardColor;
            --font-heading: 'Nunito', system-ui, -apple-system, sans-serif;
            --font-body: 'Inter', system-ui, -apple-system, sans-serif;
            --surface-border: color-mix(in srgb, var(--brand-text) 10%, transparent);
            --surface-muted: color-mix(in srgb, var(--brand-text) 5%, transparent);
        }

        html, body { min-height: 100%; }
        html { scroll-padding-top: 88px; }
        body {
            background:
                radial-gradient(ellipse at 12% 0%, color-mix(in srgb, var(--brand-primary) 8%, transparent), transparent 36rem),
                radial-gradient(ellipse at 92% 24%, color-mix(in srgb, var(--brand-accent) 7%, transparent), transparent 32rem),
                var(--brand-bg);
            color: var(--brand-text);
            font-family: var(--font-body);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        h1, h2, h3, h4, h5, h6 {
            font-family: var(--font-heading);
            font-weight: 800;
        }
        a { color: var(--brand-primary); }
        a:hover { color: var(--brand-primary-hover); }
        .btn-primary {
            background-color: var(--brand-primary) !important;
            border-color: var(--brand-primary) !important;
        }
        .btn-primary:hover, .btn-primary:focus {
            background-color: var(--brand-primary-hover) !important;
            border-color: var(--brand-primary-hover) !important;
        }

        /* Шапка: цвет темы плавно растворяется в поверхности сайта. */
        .site-header {
            position: sticky;
            top: 0;
            z-index: 100;
            isolation: isolate;
            background: linear-gradient(180deg,
                color-mix(in srgb, var(--brand-primary) 15%, var(--brand-card)) 0%,
                color-mix(in srgb, var(--brand-accent) 7%, var(--brand-card)) 48%,
                var(--brand-card) 100%);
            border-bottom: 1px solid var(--surface-border);
            box-shadow: 0 8px 28px color-mix(in srgb, var(--brand-text) 7%, transparent);
            transition: transform .28s ease, box-shadow .28s ease;
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }
        .site-header::before {
            content: "";
            position: absolute;
            z-index: -1;
            inset: 0 0 auto;
            height: 3px;
            background: linear-gradient(90deg, var(--brand-primary), var(--brand-accent), color-mix(in srgb, var(--brand-primary) 30%, transparent));
            opacity: .85;
        }
        .site-header.hidden { transform: translateY(-100%); box-shadow: none; }
        .site-header .navbar { padding: 12px 0; }
        .site-header .navbar > .container { gap: 18px; }
        .site-header .navbar-brand {
            font-family: var(--font-heading);
            font-weight: 800;
            font-size: clamp(16px, 1.3vw, 20px);
            letter-spacing: -.035em;
            color: var(--brand-text) !important;
            display: flex;
            align-items: center;
            gap: 10px;
            white-space: nowrap;
            margin-right: 10px;
        }
        .site-header .navbar-brand img {
            width: 38px;
            height: 38px;
            border-radius: 13px;
            object-fit: cover;
            box-shadow: 0 3px 10px color-mix(in srgb, var(--brand-text) 14%, transparent);
        }
        .site-header .navbar-nav { align-items: center; gap: 4px; }
        .site-header .nav-link {
            position: relative;
            color: var(--brand-text) !important;
            font-size: 14px;
            font-weight: 700;
            padding: 9px 13px !important;
            border-radius: 11px;
            transition: background-color .18s ease, color .18s ease, transform .18s ease;
        }
        .site-header .nav-link:hover {
            background: color-mix(in srgb, var(--brand-primary) 9%, transparent);
            color: var(--brand-primary) !important;
        }
        .site-header .nav-link.active {
            color: var(--brand-primary) !important;
            background: color-mix(in srgb, var(--brand-primary) 11%, transparent);
        }
        .site-header .nav-link.active:not(.cta)::after {
            content: "";
            position: absolute;
            left: 13px;
            right: 13px;
            bottom: 3px;
            height: 2px;
            border-radius: 2px;
            background: var(--brand-accent);
        }
        .site-header .nav-link.cta {
            background: var(--brand-primary);
            color: #fff !important;
            padding: 10px 17px !important;
            border-radius: 12px;
            box-shadow: 0 4px 12px color-mix(in srgb, var(--brand-primary) 24%, transparent);
        }
        .site-header .nav-link.cta:hover {
            background: var(--brand-primary-hover);
            color: #fff !important;
            transform: translateY(-1px);
            box-shadow: 0 6px 16px color-mix(in srgb, var(--brand-primary) 30%, transparent);
        }
        .site-header .navbar-toggler {
            border-color: var(--surface-border);
            border-radius: 12px;
            padding: 7px 10px;
            box-shadow: none;
        }
        .site-header .navbar-toggler:focus { box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand-primary) 16%, transparent); }
        .site-header .navbar-toggler-icon { filter: none; }

        .user-chip {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 13px;
            border: 1px solid var(--surface-border);
            border-radius: 999px;
            background: color-mix(in srgb, var(--brand-card) 70%, transparent);
            color: var(--brand-text);
            font-size: 14px;
            text-decoration: none;
            font-weight: 700;
            max-width: 220px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            transition: background .18s ease, border-color .18s ease;
        }
        .user-chip:hover {
            background: color-mix(in srgb, var(--brand-primary) 8%, var(--brand-card));
            border-color: color-mix(in srgb, var(--brand-primary) 25%, transparent);
            color: var(--brand-text);
        }

        /* Контент сохраняет тему, а мягкие цветовые пятна убирают ощущение плоского фона. */
        .site-main { flex: 1; position: relative; }
        .site-main .container { padding-top: 28px; padding-bottom: 28px; }

        .site-footer {
            position: relative;
            overflow: hidden;
            background: linear-gradient(180deg,
                color-mix(in srgb, var(--brand-card) 78%, var(--brand-bg)) 0%,
                var(--brand-bg) 100%);
            border-top: 1px solid var(--surface-border);
            padding: 27px 0;
            margin-top: 44px;
            color: color-mix(in srgb, var(--brand-text) 68%, transparent);
            font-size: 13px;
            text-align: center;
        }
        .site-footer::before {
            content: "";
            position: absolute;
            width: min(520px, 80vw);
            height: 100px;
            left: 50%;
            top: -80px;
            transform: translateX(-50%);
            border-radius: 50%;
            background: color-mix(in srgb, var(--brand-accent) 12%, transparent);
            filter: blur(35px);
            pointer-events: none;
        }
        .site-footer .container { position: relative; }
        .site-footer a {
            color: var(--brand-primary);
            font-weight: 700;
            text-decoration: none;
            text-underline-offset: 3px;
        }
        .site-footer a:hover { color: var(--brand-primary-hover); text-decoration: underline; }

        @@media (max-width: 991.98px) {
            .site-header .navbar > .container { gap: 10px; }
            .site-header .navbar-brand { margin-right: 0; }
            .site-header .nav-link { padding: 9px 10px !important; }
        }
        @@media (max-width: 767.98px) {
            .site-header .navbar { padding: 10px 0; }
            .site-header .navbar-collapse {
                padding: 14px 0 4px;
                margin-top: 10px;
                border-top: 1px solid var(--surface-border);
            }
            .site-header .navbar-nav { align-items: stretch; gap: 5px; }
            .site-header .nav-link { padding: 11px 13px !important; }
            .site-header .nav-link.active:not(.cta)::after { display: none; }
            .site-header .nav-link.cta { text-align: center; margin-top: 5px; }
            .site-header .navbar-nav + .navbar-nav { margin-top: 8px; }
            .user-chip { width: 100%; max-width: none; justify-content: center; margin-top: 4px; }
            .site-main .container { padding-top: 20px; padding-bottom: 20px; }
            .site-footer { margin-top: 28px; padding: 23px 0; }
        }

        @@media (prefers-reduced-motion: reduce) {
            .site-header, .site-header .nav-link, .site-header .nav-link.cta, .user-chip { transition: none; }
        }
    </style>
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-md">
            <div class="container">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    @{
                        var brandAvatar = DesignService.GetLocalAvatarUrl() ?? DesignService.GetGuildIconUrl();
                    }
                    @if (!string.IsNullOrEmpty(brandAvatar))
                    {
                        <img src="@brandAvatar" alt="" />
                    }
                    Сообщество Аниматоров
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNav" aria-controls="mainNav"
                        aria-expanded="false" aria-label="Меню">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0">
                        <li class="nav-item">
                            <a class="@ActiveClass("AnimJams")" asp-controller="AnimJams" asp-action="Index">Аниджемы</a>
                        </li>
                        <li class="nav-item">
                            <a class="@ActiveClass("Participants")" asp-controller="Participants" asp-action="Index">Участники</a>
                        </li>
                        @if (User.HasClaim("is_moderator", "true"))
                        {
                            <li class="nav-item">
                                <a class="@ActiveClass("Moderator")" asp-controller="Moderator" asp-action="Index">Модераторская</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="user-chip" asp-controller="User" asp-action="Profile">
                                    👤 @User.Identity.Name
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Logout">Выйти</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link cta" asp-controller="Account" asp-action="Login">Войти через Discord</a>
                            </li>
                        }
                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <div class="site-main">
        <main role="main" class="container">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container">
            Сообщество Аниматоров —
            <a href="https://discord.com/invite/AfK6h3rpDh" target="_blank" rel="noopener">наш Discord-сервер</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        (function () {
            const header = document.querySelector('.site-header');
            if (!header) return;

            let lastScroll = window.scrollY;
            const threshold = 10;        // на сколько пикселей надо прокрутить, чтобы среагировать
            const showAtTop = 80;        // до этой позиции шапка всегда видна

            window.addEventListener('scroll', () => {
                const current = window.scrollY;

                // У самого верха — всегда показываем
                if (current <= showAtTop) {
                    header.classList.remove('hidden');
                    lastScroll = current;
                    return;
                }

                const diff = current - lastScroll;

                if (Math.abs(diff) < threshold) return;

                if (diff > 0) {
                    // Скролл вниз — прячем
                    header.classList.add('hidden');
                } else {
                    // Скролл вверх — показываем
                    header.classList.remove('hidden');
                }

                lastScroll = current;
            }, { passive: true });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>